 src/hb-ot-map.cc                  | 132 +++++++++++++++++++++++++++++++++-----
 src/hb-ot-shape-complex-arabic.cc |  24 ++++++-
 src/hb-private.hh                 |   5 ++
 4 files changed, 181 insertions(+), 30 deletions(-)

