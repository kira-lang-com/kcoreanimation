    [kn_ka=0+970|kn_matra_uu=0+1375]
    
    $ make -j5 lib -s && ./hb-shape Kannada\ MN.ttc -u 0C95,0CC2 --features=-dist
    [kn_ka=0+1030|kn_matra_uu=0+1375]

