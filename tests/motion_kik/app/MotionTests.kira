import Foundation
import KCoreAnimation

// --- helpers ---------------------------------------------------------------

// Folds a float to an Number the runner can compare, keeping `digits` of it.
//
// Rounded rather than truncated. These are physical quantities reached through
// exponentials and roots, so the last digit carries the arithmetic's own error
// — a spring that arrives at 99.99999 has arrived, and a truncating fold would
// report it as 99.99 and fail a test about whether it got there.
function scaled(value: Number, digits: Number) -> Number {
    var scale = 1.0
    for _ in 0..digits {
        scale = scale * 10.0
    }
    return round(value * scale)
}

// Runs a spring for `seconds` at a given frame rate and answers where it got to.
function runSpring(
    spring: MotionSpring,
    from: Number,
    velocity: Number,
    seconds: Number,
    fps: Number
) -> Number {
    var state = motionSpringStart(move spring, from, velocity)
    let step = 1.0 / fps
    // Counted rather than accumulated against a deadline: `1.0/60.0` is not
    // exact, so a `while elapsed < seconds` loop takes a different NUMBER of
    // steps at different rates and the two runs stop at different times. That
    // would make the frame-rate test below measure the loop rather than the
    // spring.
    var value = from
    for _ in 0..Number(round(seconds * fps)) {
        let sample = motionSpringAdvance(state, step)
        value = sample.value
    }
    return value
}

// The furthest a spring ever gets from where it started, which is how far past
// the target it went when the target is ahead of it.
function springPeak(spring: MotionSpring, from: Number, seconds: Number) -> Number {
    var state = motionSpringStart(move spring, from, 0.0)
    var peak = from
    var elapsed = 0.0
    while elapsed < seconds {
        let sample = motionSpringAdvance(state, 0.004)
        if sample.value > peak {
            peak = sample.value
        }
        elapsed = elapsed + 0.004
    }
    return peak
}

// --- springs ---------------------------------------------------------------

// A critically damped spring arrives and stops. Two digits of the target after
// a second is the whole claim: it got there.
construct MtCriticallyDampedArrives() extends Test {
    test {
        let spring = MotionSpring { response: 0.4, damping: 1.0, target: 100.0 }
        return scaled(runSpring(move spring, 0.0, 0.0, 1.5, 120.0), 2)
    }
    expect { return .Ok(10000) }
}

// And never passes it. This is what damping 1.0 BUYS, and the reason a panel
// being placed uses it: the peak is the target, not beyond it.
construct MtCriticallyDampedNeverOvershoots() extends Test {
    test {
        let spring = MotionSpring { response: 0.4, damping: 1.0, target: 100.0 }
        let peak = springPeak(move spring, 0.0, 2.0)
        if peak > 100.0 {
            return 1
        }
        return 0
    }
    expect { return .Ok(0) }
}

// An underdamped one does pass it — that is what bounce means — and comes back.
construct MtUnderdampedOvershootsThenSettles() extends Test {
    test {
        let bouncy = MotionSpring { response: 0.5, damping: 0.7, target: 100.0 }
        let peak = springPeak(move bouncy, 0.0, 3.0)
        let settled = runSpring(
            MotionSpring { response: 0.5, damping: 0.7, target: 100.0 },
            0.0,
            0.0,
            3.0,
            120.0
        )
        if peak <= 100.5 {
            return 0
        }
        return scaled(settled, 1)
    }
    expect { return .Ok(1000) }
}

// The overdamped branch is a different solution entirely — two real exponentials
// rather than a decaying sine — and it still has to arrive.
construct MtOverdampedArrives() extends Test {
    test {
        let spring = MotionSpring { response: 0.4, damping: 2.5, target: 100.0 }
        return scaled(runSpring(move spring, 0.0, 0.0, 3.0, 120.0), 1)
    }
    expect { return .Ok(1000) }
}

// The reason the solution is closed-form rather than integrated per frame: the
// same spring at 60Hz and at 240Hz is in the SAME PLACE at the same moment. A
// stepped integrator disagrees between the two, and by more when frames are
// dropped.
construct MtSpringIsFrameRateIndependent() extends Test {
    test {
        let slow = runSpring(
            MotionSpring { response: 0.5, damping: 0.7, target: 100.0 },
            0.0,
            0.0,
            0.6,
            60.0
        )
        let fast = runSpring(
            MotionSpring { response: 0.5, damping: 0.7, target: 100.0 },
            0.0,
            0.0,
            0.6,
            240.0
        )
        return scaled(abs(slow - fast), 3)
    }
    expect { return .Ok(0) }
}

// Retargeting mid-flight is continuous: the value the instant after the new
// target is set is the value the instant before it. A spring restarted from
// rest would jump here, and that jump is the hitch this whole design exists to
// avoid.
construct MtRetargetIsContinuous() extends Test {
    test {
        var state = motionSpringStart(
            MotionSpring { response: 0.5, damping: 0.7, target: 100.0 },
            0.0,
            0.0
        )
        var elapsed = 0.0
        while elapsed < 0.2 {
            let ignored = motionSpringAdvance(state, 0.008)
            elapsed = elapsed + 0.008
        }
        let before = motionSpringSample(state, state.elapsed)
        motionSpringRetarget(state, 0.0)
        let after = motionSpringSample(state, state.elapsed)
        return scaled(abs(after.value - before.value), 4) * 10 + scaled(
            abs(after.velocity - before.velocity),
            2
        )
    }
    expect { return .Ok(0) }
}

// A release hands its velocity over, so a spring thrown toward its target gets
// there sooner than one that starts still.
construct MtInitialVelocityIsCarried() extends Test {
    test {
        let thrown = runSpring(
            MotionSpring { response: 0.5, damping: 1.0, target: 100.0 },
            0.0,
            300.0,
            0.15,
            240.0
        )
        let still = runSpring(
            MotionSpring { response: 0.5, damping: 1.0, target: 100.0 },
            0.0,
            0.0,
            0.15,
            240.0
        )
        if thrown > still {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// The two spellings of one spring describe the same oscillator.
construct MtCoefficientsRoundTrip() extends Test {
    test {
        let original = MotionSpring { response: 0.5, damping: 0.7, target: 0.0 }
        let stiffness = motionSpringStiffness(original)
        let damping = motionSpringDampingCoefficient(original)
        let rebuilt = motionSpringFromCoefficients(stiffness, damping, 0.0)
        return scaled(rebuilt.response, 4) * 10000 + scaled(rebuilt.damping, 4)
    }
    expect { return .Ok(50007000) }
}

// Reduced motion takes the elastic out: the same named curve stops overshooting.
construct MtReducedMotionRemovesOvershoot() extends Test {
    test {
        let plain = motionCurveFor(.Bouncy, 100.0, false)
        let reduced = motionCurveFor(.Bouncy, 100.0, true)
        let plainPeak = springPeak(move plain, 0.0, 2.0)
        let reducedPeak = springPeak(move reduced, 0.0, 2.0)
        if plainPeak > 100.5 && reducedPeak <= 100.0 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// --- rubber banding --------------------------------------------------------

// The published numbers for the platform's own curve: pulling 5 points against
// a 960-point dimension gives about 2.74, and pulling the whole 960 gives about
// 340.65. These are the assertion because they are what the shipping system
// does — a curve that merely looked similar would miss them.
construct MtRubberBandMatchesThePlatformCurve() extends Test {
    test { return scaled(motionRubberBand(5.0, 960.0, 0.55), 2) }
    expect { return .Ok(274) }
}

construct MtRubberBandResistsAFullPull() extends Test {
    test { return scaled(motionRubberBand(960.0, 960.0, 0.55), 2) }
    expect { return .Ok(34065) }
}

// Resistance always gives less than was asked for, and never nothing.
construct MtRubberBandIsBoundedByThePull() extends Test {
    test {
        let banded = motionRubberBand(200.0, 800.0, 0.55)
        if banded < 200.0 && banded > 0.0 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// The inverse recovers the pull, which is what lets a drag pick up a surface
// that is already held past its edge without the content jumping under the
// finger.
construct MtRubberBandInverseRoundTrips() extends Test {
    test {
        let banded = motionRubberBand(137.0, 800.0, 0.55)
        let recovered = motionRubberBandInverse(banded, 800.0, 0.55)
        return scaled(abs(recovered - 137.0), 3)
    }
    expect { return .Ok(0) }
}

// The curve is symmetric about zero: pulling past the top feels like pulling
// past the bottom.
construct MtRubberBandIsSymmetric() extends Test {
    test {
        let up = motionRubberBandSigned(-60.0, 800.0, 0.55)
        let down = motionRubberBandSigned(60.0, 800.0, 0.55)
        return scaled(up + down, 4)
    }
    expect { return .Ok(0) }
}

// --- decay -----------------------------------------------------------------

// A fling at 1000 points a second travels about 499.5 points before stopping.
// This is the continuous form of the platform's per-millisecond decay rate.
construct MtDecayProjectsAFling() extends Test {
    test { return scaled(motionDecayProjection(1000.0, 0.998), 1) }
    expect { return .Ok(4995) }
}

// A faster rate stops sooner, which is what a picker wants and a long list
// does not.
construct MtFastDecayStopsSooner() extends Test {
    test {
        let normal = motionDecayProjection(1000.0, MotionDecay.rateNormal)
        let fast = motionDecayProjection(1000.0, MotionDecay.rateFast)
        if fast < normal {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// The projection is where the simulation actually ends up. If these disagreed,
// a snapped list would pick its item from one number and land on another.
construct MtDecayReachesItsProjection() extends Test {
    test {
        let projected = motionDecayProjection(1000.0, 0.998)
        let travelled = motionDecayOffset(1000.0, 0.998, 20.0)
        return scaled(abs(projected - travelled), 1)
    }
    expect { return .Ok(0) }
}

// Velocity decays toward nothing rather than reversing.
construct MtDecayVelocityFallsTowardZero() extends Test {
    test {
        let early = motionDecayVelocity(1000.0, 0.998, 0.1)
        let late = motionDecayVelocity(1000.0, 0.998, 1.0)
        if early > late && late > 0.0 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// --- snapping --------------------------------------------------------------

construct MtSnapPicksTheNearestItem() extends Test {
    test { return trunc(motionSnapNearest(137.0, 50.0, 0.0)) }
    expect { return .Ok(150) }
}

// A hard throw passes more items than a flick, because the snap is taken from
// where the throw was GOING rather than from where the finger left.
construct MtSnapFollowsTheThrowsStrength() extends Test {
    test {
        let flick = motionSnapNearest(0.0 + motionDecayProjection(200.0, 0.998), 50.0, 0.0)
        let throw = motionSnapNearest(0.0 + motionDecayProjection(2000.0, 0.998), 50.0, 0.0)
        if throw > flick {
            return trunc(flick)
        }
        return -1
    }
    expect { return .Ok(100) }
}

// A paged surface moves by one, however hard it is thrown.
construct MtPagingAdvancesOneStep() extends Test {
    test { return trunc(motionSnapNextPage(0.0, 900.0, 100.0, 0.0)) }
    expect { return .Ok(100) }
}
