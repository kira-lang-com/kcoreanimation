import Foundation
import KCoreAnimation

// The highlight, checked against the shipping implementation it is taken from:
// a two-state fade with different durations each way, a smooth radial bell, a
// light that travels with the finger, and opens out over the surface when the
// finger is dragged away.

function mgStep() -> Float {
    return 1.0 / 240.0
}

// Runs a light for `seconds` and answers its level at the end.
function mgRun(state: borrow mut MotionGlowState, seconds: Float) -> Float {
    var frames = 0
    let total = Int(round(seconds / mgStep()))
    var level = 0.0
    while frames < total {
        level = motionGlowAdvance(state, mgStep())
        frames = frames + 1
    }
    return level
}

// --- the fade --------------------------------------------------------------

// A held press reaches full brightness in the fade-in time and not before.
construct MgAPressReachesItsLevel() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 0.0, 0.0)
        let level = mgRun(state, motionGlowFadeIn())
        return mtScaled(level, 3)
    }
    expect { return .Ok(120) }
}

// It is most of the way there in half that time: the curve is eased OUT, so the
// press is answered immediately rather than ramping in linearly.
construct MgTheFadeInIsFrontLoaded() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 0.0, 0.0)
        let half = mgRun(state, motionGlowFadeIn() * 0.5)
        if half > motionGlowLevel() * 0.6 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// Leaving takes longer than arriving. The two directions are not one motion
// reversed, and this is the number that makes the light drain rather than
// switch off.
construct MgTheFadeOutIsSlowerThanTheFadeIn() extends Test {
    test {
        if motionGlowFadeOut() > motionGlowFadeIn() * 1.5 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// Released, it goes out completely — and only after the fade-out time.
construct MgAReleaseGoesDarkInItsOwnTime() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 0.0, 0.0)
        let ignored = mgRun(state, motionGlowFadeIn())
        motionGlowRelease(state)
        let midway = mgRun(state, motionGlowFadeOut() * 0.5)
        let ended = mgRun(state, motionGlowFadeOut() * 0.5)
        if midway <= 0.0 {
            return 0 - 1
        }
        if motionGlowLit(state) {
            return 0 - 2
        }
        return mtScaled(ended, 3)
    }
    expect { return .Ok(0) }
}

// A tap too quick to reach full brightness fades from where it actually got to.
// Snapping up to full first and then fading is the version that flickers.
construct MgAQuickTapFadesFromWhereItReached() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 0.0, 0.0)
        // Released a quarter of the way into the fade-in.
        let partial = mgRun(state, motionGlowFadeIn() * 0.25)
        motionGlowRelease(state)
        let afterOneFrame = motionGlowAdvance(state, mgStep())
        if afterOneFrame > partial {
            return 0 - 1
        }
        if partial >= motionGlowLevel() {
            return 0 - 2
        }
        return 1
    }
    expect { return .Ok(1) }
}

// --- the radial falloff ----------------------------------------------------

function mgNear() -> Float {
    return motionGlowDiameter() * 0.5
}

// Bright at the touch: full under the finger, and the point half gone its
// width out, so the light is where the finger is.
construct MgTheTouchPointIsBright() extends Test {
    test {
        let center = motionGlowFalloff(0.0, mgNear())
        let edge = motionGlowFalloff(mgNear() * motionGlowPointWidth(), mgNear())
        return mtScaled(center, 2) * 1000 + mtScaled(edge, 2)
    }
    expect { return .Ok(100067) }
}

// Halfway out the point is spent and the bell is what is left.
construct MgTheFalloffIsTheBellHalfway() extends Test {
    test { return mtScaled(motionGlowFalloff(mgNear() * 0.5, mgNear()), 3) }
    expect { return .Ok(149) }
}

construct MgTheFalloffReachesNothingAtTheRim() extends Test {
    test {
        let rim = motionGlowFalloff(mgNear(), mgNear())
        let beyond = motionGlowFalloff(mgNear() * 2.0, mgNear())
        return mtScaled(rim + beyond, 3)
    }
    expect { return .Ok(0) }
}

// It never rises on the way out.
construct MgTheFalloffOnlyFalls() extends Test {
    test {
        var previous = 2.0
        var step = 0
        while step <= 20 {
            let here = motionGlowFalloff(mgNear() * Float(step) / 20.0, mgNear())
            if here > previous {
                return 0
            }
            previous = here
            step = step + 1
        }
        return 1
    }
    expect { return .Ok(1) }
}

// --- the spread --------------------------------------------------------------

// Held still, the light is the finger's: its own size, at full level, on it.
construct MgAStillPressStaysOnTheFinger() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowFit(state, 400.0, 300.0)
        motionGlowPress(state, 40.0, 30.0)
        motionGlowMove(state, 44.0, 30.0)
        let ignored = mgRun(state, 0.5)
        let light = motionGlowLight(state)
        if light.radius == mgNear() && light.x == 44.0 {
            return mtScaled(light.strength, 3)
        }
        return 0 - 1
    }
    expect { return .Ok(120) }
}

// Given a reach, the light under a still finger is that wide, and spreading
// over an element smaller than it never draws it in: a window-wide light on a
// small control falls off across the window, leaving the control a trace.
construct MgAReachSetsHowFarTheLightGoes() extends Test {
    test {
        var still = MotionGlowState {}
        motionGlowFit(still, 120.0, 40.0, 3000.0)
        motionGlowPress(still, 20.0, 20.0)
        let ignored = mgRun(still, 0.5)
        var dragged = MotionGlowState {}
        motionGlowFit(dragged, 120.0, 40.0, 3000.0)
        motionGlowPress(dragged, 20.0, 20.0)
        motionGlowMove(dragged, 110.0, 20.0)
        let alsoIgnored = mgRun(dragged, 1.0)
        var out = 0
        if motionGlowLight(still).radius == 1500.0 {
            out = out + 1
        }
        if motionGlowLight(dragged).radius == 1500.0 {
            out = out + 10
        }
        // Across the window from the touch, a trace and no more.
        let far = motionGlowFalloff(1300.0, 1500.0)
        if far > 0.0 && far < 0.05 {
            out = out + 100
        }
        return out
    }
    expect { return .Ok(111) }
}

// Dragged well away, it lets go of the finger: wide enough to reach every
// corner, near the middle, and dimmer.
construct MgADragSpreadsTheLight() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowFit(state, 400.0, 300.0)
        motionGlowPress(state, 40.0, 30.0)
        motionGlowMove(state, 140.0, 30.0)
        let ignored = mgRun(state, 1.0)
        let light = motionGlowLight(state)
        if light.radius < 499.0 {
            return 0 - 1
        }
        if abs(light.x - 200.0) > abs(140.0 - 200.0) * 0.3 {
            return 0 - 2
        }
        return mtScaled(light.strength, 3)
    }
    expect { return .Ok(60) }
}

// It spreads over time, not in one frame.
construct MgTheSpreadEasesIn() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowFit(state, 400.0, 300.0)
        motionGlowPress(state, 40.0, 30.0)
        motionGlowMove(state, 140.0, 30.0)
        let ignored = motionGlowAdvance(state, mgStep())
        if state.spread > 0.1 {
            return 0
        }
        return 1
    }
    expect { return .Ok(1) }
}

// Let go, it does not gather back: it opens out wider as it drains.
construct MgAReleaseOpensTheLightOut() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowFit(state, 400.0, 300.0)
        motionGlowPress(state, 40.0, 30.0)
        let ignored = mgRun(state, 0.5)
        let held = motionGlowLight(state)
        motionGlowRelease(state)
        let fading = mgRun(state, motionGlowFadeOut() * 0.5)
        let leaving = motionGlowLight(state)
        if leaving.radius > held.radius * 1.3 && leaving.x == held.x {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// --- the light follows the finger ------------------------------------------

// The highlight is centered where the touch is, not in the middle of what was
// touched, and it tracks with no easing of its own — a light that lagged the
// finger would trail the thing causing it.
construct MgTheLightIsCenteredOnTheTouch() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 40.0, 10.0)
        let ignored = mgRun(state, motionGlowFadeIn())
        let atTouch = motionGlowAt(state, 40.0, 10.0)
        let awayFromIt = motionGlowAt(state, 40.0 + motionGlowDiameter() * 0.4, 10.0)
        if atTouch > awayFromIt && awayFromIt > 0.0 {
            return mtScaled(atTouch, 3)
        }
        return 0 - 1
    }
    expect { return .Ok(120) }
}

construct MgTheLightTracksTheFinger() extends Test {
    test {
        var state = MotionGlowState {}
        motionGlowPress(state, 0.0, 0.0)
        let ignored = mgRun(state, motionGlowFadeIn())
        motionGlowMove(state, 90.0, 0.0)
        // Moved with no frame in between: the light is already there.
        let atNew = motionGlowAt(state, 90.0, 0.0)
        return mtScaled(atNew, 3)
    }
    expect { return .Ok(120) }
}

// --- overlapping touches ---------------------------------------------------

// Two touches are two lights and they add up. This is what a fast run of taps
// actually is, and it is why the response looks like it ramps and holds: the
// fades overlap. One accumulating reservoir would get that silhouette but could
// not put two lights in two places, which is what two fingers are.
construct MgOverlappingTouchesAddUp() extends Test {
    test {
        var first = MotionGlowState {}
        motionGlowPress(first, 0.0, 0.0)
        let alone = mgRun(first, motionGlowFadeIn())

        var second = MotionGlowState {}
        motionGlowPress(second, 0.0, 0.0)
        let ignored = mgRun(second, motionGlowFadeIn())
        let together = motionGlowAt(first, 0.0, 0.0) + motionGlowAt(second, 0.0, 0.0)
        if together > alone * 1.9 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// Two touches far apart light two places rather than one brighter one.
construct MgTwoFingersLightTwoPlaces() extends Test {
    test {
        var left = MotionGlowState {}
        var right = MotionGlowState {}
        motionGlowPress(left, 0.0, 0.0)
        motionGlowPress(right, 400.0, 0.0)
        let ignoredL = mgRun(left, motionGlowFadeIn())
        let ignoredR = mgRun(right, motionGlowFadeIn())
        // Each is lit at its own touch and dark at the other's.
        let leftAtRight = motionGlowAt(left, 400.0, 0.0)
        let rightAtLeft = motionGlowAt(right, 0.0, 0.0)
        if leftAtRight == 0.0 && rightAtLeft == 0.0 {
            return mtScaled(motionGlowAt(left, 0.0, 0.0), 3)
        }
        return 0 - 1
    }
    expect { return .Ok(120) }
}

// An unlit element asks for no frames.
construct MgADarkElementNeedsNoFrames() extends Test {
    test {
        var state = MotionGlowState {}
        if motionGlowLit(state) {
            return 1
        }
        return 0
    }
    expect { return .Ok(0) }
}

// --- the two press springs -------------------------------------------------

// Down is quick and mostly damped; up is slower and bouncy enough to overshoot.
// One spring for both is the version that loses the elasticity.
construct MgTheReleaseSpringIsBouncierThanThePress() extends Test {
    test {
        let on = motionLiftOn(1.0)
        let off = motionLiftOff(1.0)
        if off.damping < on.damping && off.response > on.response {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// The release spring actually passes its target — that is what bouncy means.
construct MgTheReleaseSpringOvershoots() extends Test {
    test {
        var state = motionSpringStart(motionLiftOff(100.0), 0.0, 0.0)
        var peak = 0.0
        var frames = 0
        while frames < 480 {
            let sample = motionSpringAdvance(state, mgStep())
            if sample.value > peak {
                peak = sample.value
            }
            frames = frames + 1
        }
        if peak > 100.0 {
            return 1
        }
        return 0
    }
    expect { return .Ok(1) }
}

// A press lifts the element toward the finger rather than pushing it in.
construct MgAPressLiftsRatherThanShrinks() extends Test {
    test {
        let lift = motionPressLiftScale(100.0)
        if lift > 1.0 {
            return mtScaled(lift, 3)
        }
        return 0
    }
    expect { return .Ok(1075) }
}
