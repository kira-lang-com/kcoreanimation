<?xml version="1.0" encoding="UTF-8"?>
<klist version="1">
<!-- The `loupe` Liquid Glass recipe, as the platform resolves it for each
     size and appearance. Lengths are points; angles are radians; blur radii
     are in the filter's units. Measured values, not code. -->
<dict>
    <string key="Recipe">loupe</string>
    <dict key="Small">
        <dict key="Light">
            <!-- Backdrop capture scale -->
            <number key="BackdropScale">1</number>
            <!-- How far the corner leans toward an ellipse -->
            <number key="Ovalization">0</number>
            <!-- Face blur radius, filter units -->
            <number key="BlurRadius">0</number>
            <!-- Blur ramp stops, signed distance -->
            <number key="BlurDistance0">-10</number>
            <number key="BlurDistance1">0</number>
            <number key="BlurDistance2">0</number>
            <number key="BlurDistance3">0</number>
            <!-- Blur radius share at each stop -->
            <number key="BlurOpacity0">0</number>
            <number key="BlurOpacity1">0</number>
            <number key="BlurOpacity2">0</number>
            <number key="BlurOpacity3">0</number>
            <!-- Inner lens -->
            <number key="InnerRefractionHeight">4.56</number>
            <number key="InnerRefractionAmount">-14.4</number>
            <!-- Outer lens -->
            <number key="OuterRefractionHeight">0</number>
            <number key="OuterRefractionAmount">0</number>
            <number key="RefractionDistance0">-1</number>
            <number key="RefractionDistance1">0</number>
            <number key="RefractionOpacity">0</number>
            <!-- Face colour matrix -->
            <number key="FaceOpacity">1</number>
            <number key="FaceBlack">0</number>
            <number key="FaceWhite">1.03</number>
            <number key="FaceSaturation">1</number>
            <number key="FaceMaxLuma">1</number>
            <number key="FaceFillRed">1</number>
            <number key="FaceFillGreen">1</number>
            <number key="FaceFillBlue">1</number>
            <number key="FaceFillAlpha">0</number>
            <!-- Edge specular -->
            <number key="SpecularHeight">1</number>
            <number key="SpecularAngle">1.5707963268</number>
            <number key="SpecularSpread">2.0943951024</number>
            <number key="SpecularAmount">0.5</number>
            <number key="SpecularOffset">-2</number>
            <number key="SpecularColorBias">-0.3</number>
            <!-- Drop shadow -->
            <number key="ShadowOpacity">0.02</number>
            <number key="ShadowAmount">12</number>
            <number key="ShadowHeight">0</number>
            <number key="ShadowOffsetX">0</number>
            <number key="ShadowOffsetY">7</number>
