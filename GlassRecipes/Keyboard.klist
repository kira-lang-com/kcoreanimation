            <number key="VibrantBlue3">0</number>
            <number key="VibrantBlue4">0.1471</number>
            <!-- how the edge specular is drawn: 0 the platform's key-fill with these values, 1 the platform's key-fill with the base spec's values, which DesignLibrary derives from the display's pixel length, 2 the Dock's light band -->
            <number key="SpecularKind">1</number>
        </dict>
