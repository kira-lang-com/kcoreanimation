<?xml version="1.0" encoding="UTF-8"?>
<klist version="1">
<!-- The `keyboard` Liquid Glass recipe, as the platform resolves it for each
     size and appearance. Lengths are points; angles are radians; blur radii
     are in the filter's units. Measured values, not code. -->
<dict>
    <string key="Recipe">keyboard</string>
    <dict key="Small">
        <dict key="Light">
            <!-- Backdrop capture scale -->
            <number key="BackdropScale">0.5</number>
            <!-- How far the corner leans toward an ellipse -->
            <number key="Ovalization">0</number>
            <!-- Face blur radius, filter units -->
            <number key="BlurRadius">2.5</number>
            <!-- Blur ramp stops, signed distance -->
            <number key="BlurDistance0">-66.67</number>
            <number key="BlurDistance1">-66.67</number>
            <number key="BlurDistance2">-1</number>
            <number key="BlurDistance3">0</number>
            <!-- Blur radius share at each stop -->
            <number key="BlurOpacity0">1</number>
            <number key="BlurOpacity1">1</number>
            <number key="BlurOpacity2">0.32</number>
            <number key="BlurOpacity3">1</number>
            <!-- Inner lens -->
            <number key="InnerRefractionHeight">20</number>
            <number key="InnerRefractionAmount">-14.4</number>
            <!-- Outer lens -->
            <number key="OuterRefractionHeight">0</number>
            <number key="OuterRefractionAmount">0</number>
            <number key="RefractionDistance0">-1</number>
            <number key="RefractionDistance1">0</number>
            <number key="RefractionOpacity">0</number>
            <!-- Face colour matrix -->
            <number key="FaceOpacity">1</number>
            <number key="FaceBlack">0.4</number>
            <number key="FaceWhite">0.88</number>
            <number key="FaceSaturation">0.8</number>
            <number key="FaceMaxLuma">1</number>
            <number key="FaceFillRed">0.87</number>
            <number key="FaceFillGreen">0.88</number>
            <number key="FaceFillBlue">0.91</number>
            <number key="FaceFillAlpha">0.7</number>
            <!-- Edge specular -->
            <number key="SpecularHeight">1</number>
            <number key="SpecularAngle">1.5707963268</number>
            <number key="SpecularSpread">1.8500490071</number>
            <number key="SpecularAmount">0.4</number>
            <number key="SpecularOffset">-1</number>
            <number key="SpecularColorBias">-0.25</number>
            <!-- Drop shadow -->
            <number key="ShadowOpacity">0</number>
            <number key="ShadowAmount">0</number>
            <number key="ShadowHeight">0</number>
            <number key="ShadowOffsetX">0</number>
            <number key="ShadowOffsetY">8</number>
            <number key="ShadowRadius">0</number>
            <number key="ShadowBlurRadius">0</number>
            <number key="ShadowDistanceOffset">0</number>
            <number key="ShadowBlack">0</number>
            <number key="ShadowWhite">1</number>
            <number key="ShadowSaturation">1</number>
            <number key="ShadowFillRed">0</number>
            <number key="ShadowFillGreen">0</number>
            <number key="ShadowFillBlue">0</number>
            <number key="ShadowFillAlpha">0.3</number>
            <!-- Edge bleed -->
            <number key="BleedOpacity">0</number>
            <number key="BleedAmount">0</number>
            <number key="BleedHeight">0</number>
            <number key="BleedBlurRadius">0</number>
            <number key="BleedDistance0">1</number>
            <number key="BleedDistance1">0</number>
            <number key="BleedBlack">0.9</number>
            <number key="BleedWhite">1</number>
            <number key="BleedSaturation">1.2</number>
            <number key="BleedDarken">1</number>
            <!-- Blur fill -->
            <number key="BlurFillRadius">0</number>
            <number key="BlurFillLighten">0</number>
            <number key="BlurFillDarken">0</number>
            <number key="BlurFillNormal">0</number>
            <!-- Ring shadow -->
            <number key="RingShadowOpacity">0</number>
            <number key="RingShadowOffset">0</number>
            <number key="RingShadowStrokeWidth">0</number>
            <number key="RingShadowBlurRadius">0</number>
            <number key="RingShadowMask">0</number>
            <!-- Output clamp -->
            <number key="Clamp">1</number>
            <number key="ClampPreserveHue">0</number>
            <!-- Glass highlight layer -->
            <number key="HighlightPresent">1</number>
            <number key="HighlightCurvature">0.75</number>
            <number key="KeyRed">1</number>
            <number key="KeyGreen">1</number>
            <number key="KeyBlue">1</number>
            <number key="KeyAlpha">1</number>
            <number key="KeyHeight">1</number>
            <number key="KeyAngle">0.436332313</number>
