import Foundation
import KiraGraphics
// The compositor's persistent state: the emission streams it writes quads into,
// the per-layer liquid-glass targets, the glyph slot record, and the one
// `UiBatchState` that holds every GPU resource, cache and dial the batch keeps
// between frames.
//
// Split out of `UiBatch.kira`, which was past the file-size ceiling with the
// declarations and the behavior in one place. What stayed there is the class
// itself, the fixed sizes and the frame lifecycle; what moved here is the shape
// of the thing a frame is accumulated into.

// One emission stream: the vertex buffer it writes into, this frame's slot in that
// buffer, and how many quads it holds. The ACTIVE stream's fields are mirrored into
// UiBatchState's contentsPtr/frameBase/quadCount so every emit path
// stays stream-agnostic; switching streams writes the live count back here.
public struct UiStream {
    var buffer: GraphicsBuffer = emptyGraphicsBuffer()
    var contentsPtr: RawPtr
    var frameBase: Int = 0
    var quadCount: Int = 0
    // The group the stream's vertices bind through. Built with the buffer, since
    // drawing has no Graphics to build one with — and a group per stream rather
    // than one rebound per draw, because the buffer is what differs.
    var vertsGroup: BindGroup = emptyBindGroup()
    // Liquid Glass surfaces emitted into this stream. The preceding scene capture
    // only rasterizes these padded sample regions; final UI remains full 4K.
    var glassBounds: [Float] = []
    var glassBoundCount: Int = 0
    var quadModes: [Int] = []
    // True when this quad uses geometry the specialized pipeline does not
    // implement. The generic pipeline is the semantic reference and handles the
    // full UiQuad transform; specialization is strictly an optional fast path.
    var quadRequiresGeneric: [Bool] = []
    // The external texture each quad samples, beside the mode that says whether
    // it samples one at all. Parallel to `quadModes` and allocated with it.
    var quadExternals: [TextureHandle] = []
    // And the one it crossfades TOWARDS, for a quad that is mid-transition.
    var quadSecondaries: [TextureHandle] = []
}

// An unallocated stream slot. A zero buffer id is what marks it: no backend hands
// out id 0, so whoever reaches the slot first can tell it apart from a live one and
// create its buffer in place.
public function placeholderStream() -> UiStream {
    return UiStream {
        contentsPtr: nullPointer()
    }
}

// Give an unallocated slot its own vertex buffer, bind group and mode table. Called
// the first time a frame reaches the slot — the first frame that stacks glass that
// deep, or the first HUD refresh — so an app that never uses one pays nothing.
public function createDrawStream(state: borrow mut UiBatchState, graphics: borrow Graphics, index: DrawStreamId) {
    if state.streams[index.raw].buffer.id != 0 {
        return
    }
    let dynamic = dynamicBufferOrReport(graphics.createDynamicBuffer("kira-ui-verts", streamFloatCapacity()), "stream buffer")
    state.streams[index.raw].buffer = dynamic.buffer
    state.streams[index.raw].contentsPtr = dynamic.contents
    // Claim a slot as the buffer is born: a glass layer opens mid-frame, after
    // beginFrameSlots has already claimed for everything that existed. The
    // HUD claims again immediately in beginHud and so spends two of its ring
    // slots on the frame it is created, which is free — a buffer nobody has drawn
    // from yet has no in-flight frame holding any of them.
    state.streams[index.raw].frameBase = graphics.dynamicBufferFrameStart(dynamic.buffer) / 4
    state.streams[index.raw].vertsGroup = bindGroupOrReport(graphics.createStorageBufferBindGroup("kira-ui-verts", vertexBufferSlot(), dynamic.buffer.id), "verts group")
    state.streams[index.raw].quadModes = zeroedInts(maxQuadsPerBatch())
    state.streams[index.raw].quadRequiresGeneric = zeroedBools(maxQuadsPerBatch())
    state.streams[index.raw].quadExternals = zeroedTextureHandles(maxQuadsPerBatch())
    state.streams[index.raw].quadSecondaries = zeroedTextureHandles(maxQuadsPerBatch())
    return
}

// What glass layer k refracts: a capture of streams 0..k (the scene texture) and
// that capture run through the blur pyramid. Both belong to the layer rather than
// the frame — stream k+1 samples them in the final pass, by which time layer k+1's
// own capture has been taken, so one shared pair would already have been overwritten.
// Layer 0's capture is the only one every glass frame needs; the rest are created
// the first time a frame stacks that deep (glassEnsureLayerScene).
public struct UiGlassLayer {
    // Capture of everything under layer k+1. `sceneSharpGroup` is how mode 3
    // reads it (the sharp tap); the blur dispatch binds the texture directly.
    var sceneTexture: GraphicsTexture = emptyGraphicsTexture()
    var sceneSharpGroup: BindGroup = emptyBindGroup()
    // The blurred capture at TWO radii, so a blur step grows the radius instead of
    // cross-fading sharp against fully-soft — that mix double-images rather than
    // blurs, which is why a low step used to read as edge refraction and nothing
    // else. `near` is the narrower of the two filters in
    // `Shaders/UiGlassBlurCommon.ksl` and `blur` the wider; mode 3 walks
    // sharp -> near -> far across the dial.
    var nearTexture: GraphicsTexture = emptyGraphicsTexture()
    var blurTexture: GraphicsTexture = emptyGraphicsTexture()
    // Both blurred levels ride ONE bind group: the compositor has four group slots
    // and five things to bind, and these two always change together.
    var softNearGroup: BindGroup = emptyBindGroup()
}

public struct UiGlyphSlot {
    var key: Int = 0
    var atlasX: Int = 0
    var atlasY: Int = 0
    var w: Int = 0
    var h: Int = 0
    var bearingX: Int = 0
    var bearingY: Int = 0
    var advance: Float = 0.0
    var valid: Bool = false
}

public struct UiBatchState {
    // One reusable empty bind group for draw slots that have no resource. Creating
    // an empty group is not free: it allocates a native state object, and the
    // compositor needs this sentinel on every stream and every glass pass.
    var emptyGroup: BindGroup = emptyBindGroup()
    var pipeline: RenderPipeline = emptyRenderPipeline()
    var rectPipeline: RenderPipeline = emptyRenderPipeline()
    var glyphPipeline: RenderPipeline = emptyRenderPipeline()
    // Icons burned or dodged into what is under them: the glyph shader, with
    // its ink taken away from the target or added to it.
    var glyphBurnPipeline: RenderPipeline = emptyRenderPipeline()
    var glyphDodgePipeline: RenderPipeline = emptyRenderPipeline()
    // Liquid-glass region pipelines. The full glass branch's static register
    // allocation throttles GPU occupancy for every fragment its pipeline
    // shades, so glass interiors route to shaders holding only the math their
    // region provably executes: the band (inside the shadow's reach) and the
    // deep core (past every edge effect). Both are exact subsets — see
    // Shaders/UiGlassBand.ksl and Shaders/UiGlassCore.ksl.
    var glassFullPipeline: RenderPipeline = emptyRenderPipeline()
    var glassBandPipeline: RenderPipeline = emptyRenderPipeline()
    var glassLensPipeline: RenderPipeline = emptyRenderPipeline()
    var glassCorePipeline: RenderPipeline = emptyRenderPipeline()
    // Interior cache: a glass interior's pixels depend only on the surface's
    // geometry, dial, material and the (static) backdrop textures, so a frame
    // where none of those changed re-presents the previous shading as an
    // opaque texel copy instead of re-running it. The cache texture is
    // drawable-sized; dirty surfaces re-render their interior patches into it
    // in a load-preserving pass before the composite, and the composite draws
    // mode-3.15 copy quads through UiGlassCopy.ksl. When the backdrop is not
    // provably static this frame, copy quads route to the band pipeline and
    // render live — the fallback is exact, never stale.
    var glassCopyPipeline: RenderPipeline = emptyRenderPipeline()
    var glassCacheTexture: GraphicsTexture = emptyGraphicsTexture()
    var glassCacheGroup: BindGroup = emptyBindGroup()
    var glassCacheSampler: GraphicsSampler = emptyGraphicsSampler()
    var glassCacheW: Int = 0
    var glassCacheH: Int = 0
    var glassCacheCleared: Bool = false
    var glassBackdropStatic: Bool = false
    // One exact key per push-order slot; a mismatch marks the surface dirty
    // for this frame. Compared field by field — never hashed — so a stale
    // interior can only follow from a value missing from `GlassSurfaceKey`,
    // not from a collision. Preallocated and written by index, the one array
    // shape proven to persist across frames in native state.
    var glassCacheKeys: [GlassSurfaceKey] = []
    var glassCacheKeySet: [Int] = []
    // Which slots this frame has already handed out, so two surfaces cannot
    // settle on the same cached interior.
    var glassCacheClaimed: [Int] = []
    var glassCacheEpochValue: Int = 0
    // Backdrop key at the last cache render vs. this frame: a mismatch means
    // the cached interiors were shaded against a different backdrop, and every
    // copy quad routes live until an emission re-renders the cache.
    var glassCacheRenderedKey: Float = -1.0
    var glassCacheKeyNow: Float = -2.0
    var glassSurfaceCursor: Int = 0
    // This frame's Liquid Glass workload (see UiBatchStats.kira). Counted on
    // every frame rather than behind a switch: each one is a single increment
    // on a path that already writes a quad or encodes a pass, and a counter
    // that only exists while a probe is on is a counter a benchmark cannot ask
    // an ordinary build for.
    var glassStatSurfaces: Int = 0
    var glassStatPatchQuads: Int = 0
    var glassStatLayers: Int = 0
    var glassStatCaptureReplays: Int = 0
    var glassStatCaptureRegions: Int = 0
    var glassStatBlurDispatches: Int = 0
    var glassStatCachedInteriors: Int = 0
    var glassStatLiveInteriors: Int = 0
    // Where `presentBatch` spent its own time this frame, in nanoseconds. The
    // frame's monotonic clock, read at the boundaries between uploading,
    // capturing the scene under the glass, blurring it and compositing.
    var presentUploadNs: Int = 0
    var presentCaptureNs: Int = 0
    var presentBlurNs: Int = 0
    var presentCompositeNs: Int = 0
    // Dirty-surface interior ranges to re-render into the cache this frame:
    // per entry, the stream index, the first band quad, and the band/lens/core
    // quad counts (contiguous by construction of pushGlass).
    var glassCacheRangeStream: [DrawStreamId] = []
    var glassCacheRangeStart: [Int] = []
    var glassCacheRangeBand: [Int] = []
    var glassCacheRangeLens: [Int] = []
    var glassCacheRangeCore: [Int] = []
    var glassCacheRangeCount: Int = 0
    // KIRA_GLASS_CACHE_OFF: route every copy quad live (band pipeline).
    var glassCacheDisabled: Bool = false
    var adaptiveGlyphPipeline: RenderPipeline = emptyRenderPipeline()
    // Metal-only fast path for an opaque fullscreen TextureView. Non-fullscreen
    // and translucent textures remain in the portable generic batch.
    var backgroundPipeline: RenderPipeline = emptyRenderPipeline()
    // The crossfade position, as a real uniform rather than a buffer bound at a
    // uniform slot. `UiBackground.ksl` declares it `uniform params`, and a
    // backend that pushes uniforms through its own call (sokol does) has no way
    // to read them out of a buffer a caller bound instead.
    // The external texture the next mode-2 quad will sample, and a bind group
    // per texture id to sample it through.
    //
    // `externalGroup` beside these is the frame's BACKDROP -- what glass blurs
    // and what the background pass draws -- and there is exactly one of those.
    // A window compositing several components has as many TextureViews as it
    // has components, and one group bound for the whole stream made every one
    // of them show whichever texture was registered last. Groups are kept
    // rather than rebuilt: an id here names a surface, and a surface outlives
    // the frame that drew it.
    var externalPending: TextureHandle = TextureHandle(0)
    var secondaryPending: TextureHandle = TextureHandle(0)
    var externalCacheIds: [TextureHandle] = []
    var externalCacheGroups: [BindGroup] = []
    // And the texture a crossfading quad is heading towards, which binds through
    // a DIFFERENT encoder group: the generic shader reads its primary from the
    // external group and its crossfade target from the near one, so the two are
    // cached apart because they are bound apart.
    var secondaryCacheIds: [TextureHandle] = []
    var secondaryCacheGroups: [BindGroup] = []
    var backgroundParams: Uniform = emptyUniform()
    var backgroundParamsGroup: BindGroup = emptyBindGroup()
    var backgroundActive: Bool = false
    // Whether a full-bleed opaque quad may be PROMOTED out of the stream and
    // drawn by the background pass instead.
    //
    // True for a window, where it is a real saving: the page color covers every
    // pixel, so drawing it through the backdrop pipeline costs one fullscreen
    // sample instead of a quad the whole batch then draws over.
    //
    // False for a surface rendered for another process. The promotion hands the
    // quad to a pass that only runs when an external texture is bound -- which a
    // window always has and a component never does -- so a component's
    // background is taken out of the batch and then not drawn at all.
    var backgroundPromotable: Bool = true
    var backgroundTransition: Float = 0.0
    var indexBuffer: GraphicsBuffer = emptyGraphicsBuffer()
    var atlasTexture: GraphicsTexture = emptyGraphicsTexture()
    var sampler: GraphicsSampler = emptyGraphicsSampler()
    var atlasGroup: BindGroup = emptyBindGroup()
    // External-texture slot (TextureView, mode 2). The fallback group binds the atlas at
    // slot 1 so the shader's texture(1)/sampler(1) arguments are always satisfied; a real
    // external texture replaces it via setExternalTexture (bind group cached per id).
    var fallbackExternalGroup: BindGroup = emptyBindGroup()
    var externalTextureId: TextureHandle = TextureHandle(0)
    var externalGroup: BindGroup = emptyBindGroup()
    var externalBindReady: Bool = false
    // Optional TextureView crossfade target. It occupies the backdrop/near group
    // only for stream 0; glass streams replace that group with their own blur pair.
    var secondaryExternalTextureId: TextureHandle = TextureHandle(0)
    var secondaryExternalGroup: BindGroup = emptyBindGroup()
    var secondaryExternalBindReady: Bool = false
    // The sharp tap over a DIRECT backdrop: both photographs, at the slots every
    // glass pipeline reads them from, with `backdropBlend` saying where between
    // them the frame stands. A run with one photo binds it as both.
    var backdropSharpGroup: BindGroup = emptyBindGroup()
    // That weight. One number for the whole screen, rewritten once a frame, and
    // read by every glass pipeline's sharp tap and by nothing else.
    var backdropBlend: Uniform = emptyUniform()
    // Per-present direct-source specialization for layer 0. Set only when the
    // captured stream contains no quads over an opaque photo; every other frame
    // uses the normal capture.
    var directBackdropLayer0: Bool = false
    var directBackdropSharpGroup: BindGroup = emptyBindGroup()
    // Which texture layer 0's blur was taken from this frame: the direct
    // backdrop's view id, or zero for the scene capture. Half of the interior
    // cache's key — an interior shaded against one photo is not the interior of
    // the same surface over another, and a capture-path frame is never static.
    var glassBlurSourceId: TextureHandle = TextureHandle(0)

    var atlasW: Int = 0
    var atlasH: Int = 0
    // The atlas's CPU side: RGBA8 for the whole texture, packed into runtime
    // memory rather than a Kira array because it is megabyte-scale and is handed
    // to the upload as a pointer.
    //
    // It exists because a glyph has to be composited BESIDE the glyphs already
    // packed: the upload replaces the whole image, and sokol has no sub-region
    // form at all. One upload per frame that added a glyph is also fewer uploads
    // than the one-per-glyph the sub-region path cost on the backend that does.
    var atlasPixels: RawPtr
    var atlasDirty: Bool = false
    // The rows of the atlas written since its last upload, `[top, bottom)`.
    var atlasDirtyTop: Int = 0
    var atlasDirtyBottom: Int = 0
    // Whether something failed to find room this frame — in the atlas, or in the
    // hash that points into it. What did not fit is drawn without ink this once
    // and is not cached, and the next frame starts the atlas over.
    var atlasExhausted: Bool = false
    // Whether this session has already announced that it drew real content.
    // The announcement is once per run, and the compositor is the only thing
    // that knows a stream held quads.
    var announcedVisibleContent: Bool = false
    var cursorX: Int = 0
    var cursorY: Int = 0
    var rowHeight: Int = 0
    var glyphs: [UiGlyphSlot] = []
    // O(1) glyph lookup: open-addressing hash from glyph cache key to index into
    // `glyphs`. Key 0 marks an empty slot (cache keys are always >= 1025).
    var glyphHashKeys: [Int] = []
    var glyphHashVals: [Int] = []

    var engine: kira_text_engine_ptr
    var face: kira_text_face_ptr
    var fontReady: Bool = false
    var fontSizeSet: Int = 0
    // The weight the face is currently set to. Paired with `fontSizeSet`: a face
    // carries size and weight as one variation state, so a run that changes
    // either must re-set both.
    var fontWeightSet: Int = 0
    var ascender: Float = 0.0
    var descender: Float = 0.0
    // The face's vertical metrics at every size and weight a run has asked
    // for, keyed `sizeKey * 1000 + weightKey`. Setting the face's size and
    // weight axes is the dear part of switching between them, and a run whose
    // glyphs are all in the atlas needs only these two numbers -- so the face
    // is set only when a glyph has to be rasterized.
    var metricKeys: [Int] = []
    var metricAscenders: [Float] = []
    var metricDescenders: [Float] = []

    // Vertices are written straight into the dynamic vertex buffer's shared contents
    // (GPU-visible memory) as they are emitted — no per-frame Kira array. Keeping a
    // 27k-float array in this nativeState struct made every emitQuad recover O(n) and
    // the frame O(n^2); writing through this raw pointer keeps the hot path O(1).
    var contentsPtr: RawPtr
    var quadCount: Int = 0
    // The vertex buffer holds one slot per frame in flight, so `contentsPtr` is the
    // base of the whole ring and this is the float index where THIS frame's slot
    // starts (claimed once per frame in beginFrameSlots). Emitting without it
    // would write the frame being built into the bytes the GPU is still drawing —
    // part of the window from one frame and part from the next.
    var frameBase: Int = 0
    // Liquid glass cuts the frame into streams — one per glass layer, in draw
    // order (see maxDrawStreams). `streamIndex` is the ACTIVE entry, the one the
    // fields above mirror; entries past stream 1 are allocated the first frame that
    // actually stacks glass, so an app that never overlaps glass pays nothing.
    var streams: [UiStream] = []
    var streamIndex: DrawStreamId = DrawStreamId(0)
    // Which stream emission returns to when the HUD is done with its own (see
    // hudStreamIndex). A HUD refresh borrows the mirrored hot fields above and
    // hands them back untouched, so a full frame can write the HUD mid-walk and a
    // HUD-only frame can write it with no frame around it at all.
    var hudReturnStream: DrawStreamId = DrawStreamId(0)
    // Diagnostic switches, read from the environment ONCE. They are launch knobs —
    // nothing changes them while a process runs — and reading them per quad or per
    // draw put a linear environ scan on the frame's hottest loops.
    var probeQuads: Bool = false
    var probeCost: Bool = false
    var probeModes: Bool = false
    var probeBatch: Bool = false
    var probeGlassLayers: Bool = false
    var probeGlassLayerOpen: Bool = false
    var layoutDebug: Bool = false
    var benchFinalOnly: Bool = false
    var benchBackgroundOnly: Bool = false
    var benchNoBackground: Bool = false
    // Which cells of the viewport the CURRENT layer has drawn into, stamped with
    // `gridStamp` so starting a layer clears the grid by bumping a counter. Only
    // maintained once a glass layer is open (nothing below the first glass surface
    // can change where its layer boundary falls).
    var glassGrid: [Int] = []
    var gridStamp: Int = 0
    // Exact clipped quad bounds for the active layer. The old 33 pt occupancy
    // cells classified adjacent controls as overlapping and doubled blur work.
    // Storage is retained and overwritten each frame to avoid allocation churn.
    var glassRects: [Float] = []
    var glassRectCount: Int = 0
    // Scratch union of padded glass sampling bounds for scene-capture scissors.
    // Retained across frames to avoid allocation in the presentation path.
    var captureRects: [Float] = []
    var captureRectCount: Int = 0
    // Offscreen liquid-glass resources, created lazily on the first glass frame and
    // recreated grow-only on resize (the backdrop capture is sampled 1:1 through uv
    // 0..1, so a target larger than the viewport still composites correctly).
    var glassReady: Bool = false
    var glassTexW: Int = 0
    var glassTexH: Int = 0
    // The blur's two horizontal intermediates: the horizontal dispatch writes
    // the near level into A and the far level into B, and the vertical one reads
    // each back into the layer's own output. Shared by every layer, because a
    // layer's chain runs to completion before the next one starts.
    var blurTextureA: GraphicsTexture = emptyGraphicsTexture()
    var blurTextureB: GraphicsTexture = emptyGraphicsTexture()
    var blurComputeHPipelineId: ComputePipelineId = ComputePipelineId(0)
    var blurComputeVPipelineId: ComputePipelineId = ComputePipelineId(0)
    // Capture + blurred backdrop per glass layer (see UiGlassLayer).
    var glassLayers: [UiGlassLayer] = []
    // The slot-2 atlas fallback that keeps texture(2)/sampler(2) satisfied on
    // streams with no glass.
    var fallbackBackdropGroup: BindGroup = emptyBindGroup()
    var glassBlurW: Int = 0
    var glassBlurH: Int = 0
    var viewportW: Float = 1.0
    var viewportH: Float = 1.0
    // The drawable, in PHYSICAL pixels, as the backend reports it — not points
    // times the backing scale. Those two disagree whenever the drawable is not a
    // whole number of points: a 991-pixel drawable at 1.25 is 792.8 points, the
    // layout gets 792, and 792 x 1.25 is 990. Anything that has to land on the
    // same pixel grid as the swapchain (the interior cache and every copy quad
    // that reads it) measures itself against these, because a cache one row
    // short of the drawable rasterizes its bottom row of glass into the row
    // above and leaves the row the composite reads cleared — a black line along
    // the bottom edge of every glass surface far enough down the window for the
    // scale difference to exceed half a pixel.
    var drawableW: Int = 1
    var drawableH: Int = 1
    // Retina backing scale (physical pixels per point). Glyphs are rasterized at
    // point-size x scale and positioned in points, so text is crisp at native
    // resolution; surfaces are SDF-shaded per physical pixel and need no extra scale.
    var scale: Float = 1.0
}
