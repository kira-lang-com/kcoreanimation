import Foundation
import Ember
// Liquid glass, the resources side: the occupancy grid that decides whether a
// surface has anything under it worth capturing, and the per-layer render targets
// the capture and its blur pyramid live in.
//
// Glass is layered because one glass surface can sit over another. Each layer owns
// a scene texture, a sharp one, a near and a far blur level, and the bind groups
// that read them,
// and a layer is only built when something actually asks for it — a UI with no
// glass allocates none of this.

// Which grid column/row a pixel coordinate falls in, clamped to the grid.
public function glassCellIndex(value: Number, extent: Number, cells: Number) -> Number {
    if extent <= 0.0 {
        return 0
    }
    var idx = trunc(value / extent * Number(cells))
    if idx < 0 {
        idx = 0
    }
    if idx >= cells {
        idx = cells - 1
    }
    return idx
}

// Record exact content bounds for the active glass layer.
public function glassMarkRect(
    state: borrow mut UiBatchState,
    x0: Number,
    y0: Number,
    x1: Number,
    y1: Number
) {
    let base = state.glassRectCount * 4
    if base + 3 < state.glassRects.count {
        state.glassRects[base] = x0
        state.glassRects[base + 1] = y0
        state.glassRects[base + 2] = x1
        state.glassRects[base + 3] = y1
    } else {
        state.glassRects.append(x0)
        state.glassRects.append(y0)
        state.glassRects.append(x1)
        state.glassRects.append(y1)
    }
    state.glassRectCount += 1
}

// Does this rect sit over anything the current glass layer has already drawn? A
// glass surface that does must start its own layer to refract it.
public function glassLayerOccupied(
    state: borrow mut UiBatchState,
    x0: Number,
    y0: Number,
    x1: Number,
    y1: Number
) -> Bool {
    for i in 0..state.glassRectCount {
        let base = i * 4
        let rx0 = state.glassRects[base]
        let ry0 = state.glassRects[base + 1]
        let rx1 = state.glassRects[base + 2]
        let ry1 = state.glassRects[base + 3]
        if x0 < rx1 && x1 > rx0 && y0 < ry1 && y1 > ry0 {
            return true
        }
    }
    return false
}

// A render pass targeting one of the glass offscreen textures.
public function glassTexturePass(
    label: String,
    texture: borrow GraphicsTexture,
    r: Number,
    g: Number,
    b: Number,
    a: Number
) -> RenderPassDescriptor {
    let target = RenderTarget { kind: .Texture, texture: texture, mipLevel: 0, arrayLayer: 0 }
    let attachment = ColorAttachment {
        target: target,
        loadAction: .Clear,
        storeAction: .Store,
        clearColor: RGBAColor { r: r, g: g, b: b, a: a },
        resolveTarget: emptyRenderTarget(),
        hasResolveTarget: false
    }
    return RenderPassDescriptor {
        label: label,
        colorAttachments: [attachment],
        primaryColorAttachment: attachment,
        hasPrimaryColorAttachment: true,
        depthAttachment: emptyDepthAttachment(),
        hasDepthAttachment: false,
        stencilAttachment: emptyStencilAttachment(),
        hasStencilAttachment: false
    }
}

public function glassDestroyTexture(graphics: borrow Graphics, texture: borrow GraphicsTexture) {
    if texture.id == 0 {
        return
    }
    graphics.destroyTexture(texture)
}

public function glassDestroyBindGroup(graphics: borrow Graphics, group: borrow BindGroup?) {
    match group {
        Some(bound) -> graphics.destroyBindGroup(bound)
        None -> {}
    }
}

// Release the application-owned references to a superseded glass target set.
// Metal command buffers retain every resource they encode until completion, so
// prior in-flight frames remain valid while the registry can stop retaining the
// old resize bucket immediately.
public function glassDestroyTargets(state: borrow mut UiBatchState, graphics: borrow Graphics) {
    glassDestroyTexture(graphics, state.blurTextureA)
    glassDestroyTexture(graphics, state.blurTextureB)
    for layer in 0..state.glassLayers.count {
        glassDestroyBindGroup(graphics, state.glassLayers[layer].sceneSharpGroup)
        glassDestroyBindGroup(graphics, state.glassLayers[layer].softNearGroup)
        if state.glassLayers[layer].sharpTexture.id != state.glassLayers[layer].sceneTexture.id {
            glassDestroyTexture(graphics, state.glassLayers[layer].sharpTexture)
        }
        glassDestroyTexture(graphics, state.glassLayers[layer].sceneTexture)
        glassDestroyTexture(graphics, state.glassLayers[layer].nearTexture)
        glassDestroyTexture(graphics, state.glassLayers[layer].blurTexture)
    }
    state.blurTextureA = emptyGraphicsTexture()
    state.blurTextureB = emptyGraphicsTexture()
    state.glassBlurW = 0
    state.glassBlurH = 0
    state.glassBlurSourceId = TextureHandle(0)
    state.glassBlurCacheSourceId = TextureHandle(0)
    state.glassBlurCacheSecondSourceId = TextureHandle(0)
    state.glassBlurCacheBlend = -1.0
    state.glassBlurCacheRegions = []
    // The interior cache is drawable-sized and its keys describe the old
    // viewport; both die with the glass targets. (The texture itself is
    // re-created lazily by glassEnsureInteriorCache at the new size.)
    state.glassCacheW = 0
    state.glassCacheH = 0
    state.glassCacheCleared = false
    state.glassCacheEpochValue += 1
    state.glassLayers = []
    state.glassReady = false
}

// Attach all targets used by glass layer `layer`. Layer 0 is built with the first
// glass frame; deeper layers are built only when a frame actually stacks that far,
// so an ordinary one- or two-layer UI does not reserve the maximum chain.
public function glassEnsureLayerScene(
    state: borrow mut UiBatchState,
    graphics: borrow Graphics,
    layer: GlassLayerId
) {
    if layer.raw < 0 || layer.raw >= state.glassLayers.count {
        return
    }
    if state.glassLayers[layer.raw].sceneTexture.id != 0 {
        return
    }
    // The scene the blur reads is a texel a point, the pyramid's divisor below
    // it; the sharp tap has its own capture at the drawable's resolution.
    let blurDiv = GlassBlur.divisor
    let sceneW = state.glassTexW
    let sceneH = state.glassTexH
    var blurW = trunc(state.glassTexW / blurDiv)
    if blurW < 1 {
        blurW = 1
    }
    var blurH = trunc(state.glassTexH / blurDiv)
    if blurH < 1 {
        blurH = 1
    }
    // The capture is drawn by the SAME pipelines that draw the swapchain — the
    // background, the batch, every glass region — so it carries the swapchain's
    // format. A color target whose format differs from the pipeline that writes
    // it is an attachment-state mismatch, which a validating backend rejects: on
    // Dawn it invalidates the whole frame's command buffer, and the window then
    // presents whatever the surface texture happened to hold.
    let scene = textureOrReport(
        graphics.createTexture(
            TextureDescriptor {
                label: "kira-ui-glass-scene",
                width: UN32(sceneW),
                height: UN32(sceneH),
                format: .Swapchain,
                usage: .RenderTargetSampled,
                sampleCount: 1,
                storage: .Transient
            }
        ),
        "glass scene target"
    )
    let sampler = state.sampler
    let nearOut = textureOrReport(
        graphics.createTexture(
            TextureDescriptor {
                label: "kira-ui-glass-blur-near",
                width: UN32(blurW),
                height: UN32(blurH),
                format: .Rgba8Unorm,
                usage: .SampledStorage,
                sampleCount: 1,
                storage: .Transient
            }
        ),
        "glass near-blur target"
    )
    let blurOut = textureOrReport(
        graphics.createTexture(
            TextureDescriptor {
                label: "kira-ui-glass-blur-out",
                width: UN32(blurW),
                height: UN32(blurH),
                format: .Rgba8Unorm,
                usage: .SampledStorage,
                sampleCount: 1,
                storage: .Transient
            }
        ),
        "glass blur target"
    )
    var sharpTexture = copy scene
    if state.glassSharpW != sceneW || state.glassSharpH != sceneH {
        sharpTexture = textureOrReport(
            graphics.createTexture(
                TextureDescriptor {
                    label: "kira-ui-glass-sharp",
                    width: UN32(state.glassSharpW),
                    height: UN32(state.glassSharpH),
                    format: .Swapchain,
                    usage: .RenderTargetSampled,
                    sampleCount: 1,
                    storage: .Transient
                }
            ),
            "glass sharp target"
        )
    }
    state.glassLayers[layer.raw].sceneTexture = scene
    state.glassLayers[layer.raw].sharpTexture = copy sharpTexture
    // The capture rides the shader's EXTERNAL slot — mode 3 reads its sharp tap
    // from the same place a TextureView reads its texture. It has to be that slot
    // and not the atlas's: two groups binding the same texture index means
    // whichever is applied last wins, and the glyphs lose their atlas.
    //
    // A capture holds ONE image — whatever crossfade it contains was rasterized
    // into it — so it stands at both of the sharp tap's two slots, and the
    // weight is 0 on every frame this group is the one bound.
    let sharp = optionalBindGroup(graphics.beginBindGroup("kira-ui-glass-scene-sharp"), "sharp")
    match sharp {
        Some(group) -> glassAddSharpBackdrop(
            graphics,
            group,
            sharpTexture,
            sharpTexture,
            sampler,
            state.backdropBlend
        )
        None -> {}
    }
    state.glassLayers[layer.raw].sceneSharpGroup = sharp
    let softNear = optionalBindGroup(
        graphics.beginBindGroup("kira-ui-glass-soft-near"),
        "soft near"
    )
    match softNear {
        Some(group) -> {
            graphics.bindGroupAddTexture(group, ShaderSlot.backdropTexture, blurOut)
            graphics.bindGroupAddSampler(group, ShaderSlot.backdropSampler, sampler)
            graphics.bindGroupAddTexture(group, ShaderSlot.nearTexture, nearOut)
            graphics.bindGroupAddSampler(group, ShaderSlot.nearSampler, sampler)
        }
        None -> {}
    }
    state.glassLayers[layer.raw].nearTexture = nearOut
    state.glassLayers[layer.raw].blurTexture = blurOut
    state.glassLayers[layer.raw].softNearGroup = softNear
}

// Ensure the glass pipelines/param buffers exist (once) and the offscreen targets
// match the current viewport and drawable. The capture is sampled through uv 0..1
// of the viewport, so a target has exactly the viewport's shape -- a larger one
// would stretch the viewport across itself, a different number of texels a
// point on each axis -- and a superseded set is retired before its replacement
// is installed.
extend UiBatch {
    function ensureGlassResources(graphics: borrow Graphics) {
        var state = nativeRecover<UiBatchState>(self.storage)
        if !state.blurComputeHPipelineId.isPresent() {
            // One `.ksl` holds one compute stage, so the two halves are two files
            // sharing `Shaders/UiGlassBlurCommon.ksl` — the filters they both run
            // are written once there.
            //
            // Compute is a requirement of the material, not a preference: a device
            // that cannot dispatch cannot show Liquid Glass, and saying so is the
            // whole of the handling. There is no second encoding of this blur to
            // fall back onto, because a second encoding is a second image nobody
            // looks at until it is already wrong.
            if !graphics.supportsCompute() {
                log fault(
                    "Kira UI Foundation requires a render backend that can dispatch compute; Liquid Glass cannot be drawn on this device"
                )
                return
            }
            let hArtifact = ksl!("Shaders/UiGlassBlurH.ksl")
            let hShader = shaderOrReport(
                graphics.createShaderFromKslArtifact("kira-ui-glass-blur-h", hArtifact),
                "h shader"
            )
            state.blurComputeHPipelineId = graphics.createComputePipeline(
                "kira-ui-glass-blur-h",
                hShader,
                hArtifact.computeEntry
            )

            let vArtifact = ksl!("Shaders/UiGlassBlurV.ksl")
            let vShader = shaderOrReport(
                graphics.createShaderFromKslArtifact("kira-ui-glass-blur-v", vArtifact),
                "v shader"
            )
            state.blurComputeVPipelineId = graphics.createComputePipeline(
                "kira-ui-glass-blur-v",
                vShader,
                vArtifact.computeEntry
            )
            if !state.blurComputeHPipelineId.isPresent() || !state.blurComputeVPipelineId.isPresent() {
                log fault("Kira UI Foundation could not build the Liquid Glass blur kernels")
                return
            }
        }

        // The blur's capture is a texel a point and its levels a quarter of that,
        // so a level texel is the divisor's points on both axes; the sharp
        // capture is the drawable's pixels.
        let texW = max(ceil(state.viewportW), 1)
        let texH = max(ceil(state.viewportH), 1)
        let sharpW = max(state.drawableW, texW)
        let sharpH = max(state.drawableH, texH)
        if state.glassReady && texW == state.glassTexW && texH == state.glassTexH
            && sharpW == state.glassSharpW && sharpH == state.glassSharpH {
            return
        }
        // The kernel steps in level texels, so the divisor sets the physical blur
        // radius and not just its quality: a finer level is a *narrower* blur.
        let blurDiv = GlassBlur.divisor
        var blurW = trunc(texW / blurDiv)
        if blurW < 1 {
            blurW = 1
        }
        var blurH = trunc(texH / blurDiv)
        if blurH < 1 {
            blurH = 1
        }
        glassDestroyTargets(state, graphics)
        let blurA = textureOrReport(
            graphics.createTexture(
                TextureDescriptor {
                    label: "kira-ui-glass-blur-a",
                    width: UN32(blurW),
                    height: UN32(blurH),
                    format: .Rgba8Unorm,
                    usage: .SampledStorage,
                    sampleCount: 1,
                    storage: .Transient
                }
            ),
            "glass blur ping target"
        )
        let blurB = textureOrReport(
            graphics.createTexture(
                TextureDescriptor {
                    label: "kira-ui-glass-blur-b",
                    width: UN32(blurW),
                    height: UN32(blurH),
                    format: .Rgba8Unorm,
                    usage: .SampledStorage,
                    sampleCount: 1,
                    storage: .Transient
                }
            ),
            "glass blur pong target"
        )
        state.blurTextureA = blurA
        state.blurTextureB = blurB
        state.glassTexW = texW
        state.glassTexH = texH
        state.glassSharpW = sharpW
        state.glassSharpH = sharpH
        state.glassBlurW = blurW
        state.glassBlurH = blurH

        // Reserve only the lightweight layer records. Their scene, far-blur and
        // near-blur textures are allocated together on first use by
        // glassEnsureLayerScene, rather than eagerly reserving the maximum stack.
        for _ in 0..DrawStreams.initialHud - 1 {
            state.glassLayers.append(UiGlassLayer {})
        }
        glassEnsureLayerScene(state, graphics, GlassLayerId(0))
        state.glassReady = true
    }
}
