import Foundation
import KiraGraphics
// Building the compositor: every pipeline the batch can draw with, created once.
//
// The generic pipeline compiled from `Shaders/UiBatch.ksl` is the one that can
// render every mode, and it is what runs on every backend. Beside it sit the four
// glass region pipelines and the Metal-only specializations, each of which draws
// a subset faster. Any of them failing to build is survivable: the draw path falls
// back to the generic pipeline, so a backend that cannot build one degrades in
// cost rather than in what it can show.


// Keep each build-time KSL artifact in its own native function. KSL artifacts
// carry the generated source for every backend; putting all of them in
// `createBatch` made one 26 MiB LLVM function and sent register allocation into
// pathological live-range work during Apple export. These helpers preserve the
// exact pipeline state while giving LLVM normal-sized machine functions.
function createBatchMainPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiBatch.ksl")
    return createArtifactPipeline(graphics, "kira-ui-batch", "kira-ui-batch-pipeline", artifact)
}

function createGlassFullPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlassFull.ksl")
    return createArtifactPipeline(graphics, "kira-ui-glass-full", "kira-ui-glass-full-pipeline", artifact)
}

function createGlassBandPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlassBand.ksl")
    return createArtifactPipeline(graphics, "kira-ui-glass-band", "kira-ui-glass-band-pipeline", artifact, false, .Replace)
}

function createGlassCorePipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlassCore.ksl")
    return createArtifactPipeline(graphics, "kira-ui-glass-core", "kira-ui-glass-core-pipeline", artifact, false, .Replace)
}

function createGlassLensPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlassLens.ksl")
    return createArtifactPipeline(graphics, "kira-ui-glass-lens", "kira-ui-glass-lens-pipeline", artifact, false, .Replace)
}

function createGlassCopyPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlassCopy.ksl")
    return createArtifactPipeline(graphics, "kira-ui-glass-copy", "kira-ui-glass-copy-pipeline", artifact, false, .Replace)
}

function createGlyphVariantPipeline(graphics: borrow Graphics, label: borrow String, preset: BlendPreset = .PremultipliedAlpha) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiGlyph.ksl")
    return createSpecializedPipeline(graphics, label, artifact, move preset)
}

function createRectFastPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiRect.ksl")
    return createSpecializedPipeline(graphics, "kira-ui-rect-fast", artifact)
}

function createBackgroundPipeline(graphics: borrow Graphics) -> RenderPipeline {
    let artifact = ksl!("Shaders/UiBackground.ksl")
    return createArtifactPipeline(graphics, "kira-ui-opaque-background", "kira-ui-opaque-background-pipeline", artifact, false, .Replace)
}

// Create the compositor's persistent GPU resources and font, store the state behind a
// nativeState handle, and return that handle.
public @Native
function createBatch(graphics: borrow Graphics) -> NativeState<UiBatchState> {
    var state = UiBatchState {
        engine: nullPointer(),
        face: nullPointer(),
        contentsPtr: nullPointer(),
        atlasPixels: nullPointer()
    }

    state.pipeline = createBatchMainPipeline(graphics)
    state.glassFullPipeline = createGlassFullPipeline(graphics)
    state.glassBandPipeline = createGlassBandPipeline(graphics)
    state.glassCorePipeline = createGlassCorePipeline(graphics)
    state.glassLensPipeline = createGlassLensPipeline(graphics)
    state.glassCopyPipeline = createGlassCopyPipeline(graphics)

    // Not behind the switch below: the generic pipeline blends everything
    // over what is under it, so a burned or dodged icon has nowhere else to
    // draw correctly.
    state.glyphBurnPipeline = createGlyphVariantPipeline(graphics, "kira-ui-glyph-burn", .PremultipliedSubtractive)
    state.glyphDodgePipeline = createGlyphVariantPipeline(graphics, "kira-ui-glyph-dodge", .PremultipliedAdditive)

    if environmentIsSet("KIRA_UI_SPECIALIZED_RUNS") {
        state.rectPipeline = createRectFastPipeline(graphics)
        state.glyphPipeline = createGlyphVariantPipeline(graphics, "kira-ui-glyph-fast")
        // Adaptive glyphs sit immediately after their glass surface. Keeping both
        // on the generic pipeline merges each island into one ordered range; a
        // separate adaptive pipeline costs more switches than it saves. That is
        // why there is no `Shaders/UiAdaptiveGlyph.ksl` — a shader nothing
        // compiles is a shader that rots.
        state.adaptiveGlyphPipeline = emptyRenderPipeline()
    }

    // This compositor is instantiated only by the Metal Foundation backend.
    // The public TextureView path still falls back to the generic pipeline.
    state.backgroundPipeline = createBackgroundPipeline(graphics)
    // A real uniform, not a buffer bound at a uniform slot: `UiBackground.ksl`
    // declares `uniform params`, and a backend that pushes uniforms through its
    // own call rather than reading them out of memory has no way to see a buffer
    // a caller bound instead.
    state.backgroundParams = uniformOrReport(graphics.createUniform(UniformDescriptor {
        label: "kira-ui-opaque-background-params",
        expectedFloatCount: 4,
        data: [F32(0.0), F32(0.0), F32(0.0), F32(0.0)]
    }), "background params")
    state.backgroundParamsGroup = bindGroupOrReport(graphics.createUniformBindGroup("kira-ui-opaque-background-params", backgroundParamsSlot(), state.backgroundParams), "background params group")

    let floatCapacity = streamFloatCapacity()
    let vbuf = dynamicBufferOrReport(graphics.createDynamicBuffer("kira-ui-verts", floatCapacity), "stream buffer")
    state.contentsPtr = vbuf.contents
    state.streams.append(UiStream {
        buffer: vbuf.buffer,
        contentsPtr: vbuf.contents,
        vertsGroup: bindGroupOrReport(graphics.createStorageBufferBindGroup("kira-ui-verts", vertexBufferSlot(), vbuf.buffer.id), "verts group"),
        quadModes: zeroedInts(maxQuadsPerBatch()),
        quadRequiresGeneric: zeroedBools(maxQuadsPerBatch()),
        quadExternals: zeroedTextureHandles(maxQuadsPerBatch()),
        quadSecondaries: zeroedTextureHandles(maxQuadsPerBatch())
    })

    // Second stream: the first glass layer. Allocated up front so the common
    // single-layer glass frame never allocates mid-frame; layers beyond this one
    // allocate on the first frame that stacks glass (openStream).
    let vbuf2 = dynamicBufferOrReport(graphics.createDynamicBuffer("kira-ui-verts", floatCapacity), "stream buffer")
    state.streams.append(UiStream {
        buffer: vbuf2.buffer,
        contentsPtr: vbuf2.contents,
        vertsGroup: bindGroupOrReport(graphics.createStorageBufferBindGroup("kira-ui-verts", vertexBufferSlot(), vbuf2.buffer.id), "verts group"),
        quadModes: zeroedInts(maxQuadsPerBatch()),
        quadRequiresGeneric: zeroedBools(maxQuadsPerBatch()),
        quadExternals: zeroedTextureHandles(maxQuadsPerBatch()),
        quadSecondaries: zeroedTextureHandles(maxQuadsPerBatch())
    })

    // The rest of the stream slots — the deeper glass layers and the HUD's own —
    // exist as placeholders from the start so every slot has a FIXED index. The HUD
    // is at hudStreamIndex() whether or not glass ever stacks that deep, which is
    // what lets a HUD refresh address its stream without disturbing the layers.
    while state.streams.count < streamSlotCount() {
        state.streams.append(placeholderStream())
    }

    state.glassGrid = zeroedInts(glassGridCells())

    let ibuf = bufferOrReport(graphics.createIndexBuffer(IndexBufferDescriptor {
        label: "kira-ui-batch-indices",
        data: quadIndices(maxQuadsPerBatch())
    }), "ibuf")
    state.indexBuffer = ibuf

    let atlasSize = glyphAtlasSize()
    let atlas = textureOrReport(graphics.createTexture(TextureDescriptor {
        label: "kira-ui-glyph-atlas",
        width: atlasSize,
        height: atlasSize,
        format: .Rgba8Unorm,
        // Streaming, because the atlas is composited into and re-uploaded as
        // glyphs are packed. An immutable image would refuse the upload.
        usage: .SampledStreaming,
        sampleCount: 1,
        storage: .Persistent
    }), "glyph atlas")
    state.atlasTexture = atlas
    state.atlasW = atlasSize
    state.atlasH = atlasSize
    // The atlas's CPU side. Zeroed, so a glyph quad whose uv strays into a slot
    // nothing has packed reads transparent rather than whatever the allocator
    // last left there.
    state.atlasPixels = allocateBytes(U64(atlasSize * atlasSize * 4))
    // Sent whole once, so the GPU's copy is as zeroed as this one: after this
    // only the rows a glyph is written to go up.
    state.atlasDirty = true
    state.atlasDirtyTop = 0
    state.atlasDirtyBottom = atlasSize
    state.cursorX = atlasGutter()
    state.cursorY = atlasGutter()
    state.rowHeight = 0

    let sampler = samplerOrReport(graphics.createSampler(SamplerDescriptor {
        label: "kira-ui-glyph-sampler",
        minFilter: .Linear,
        magFilter: .Linear,
        addressModeU: .ClampToEdge,
        addressModeV: .ClampToEdge
    }), "sampler")
    state.sampler = sampler

    let bindGroup = bindGroupOrReport(graphics.beginBindGroup("kira-ui-batch-atlas"), "bind group")
    graphics.bindGroupAddTexture(bindGroup, atlasTextureSlot(), atlas)
    graphics.bindGroupAddSampler(bindGroup, atlasSamplerSlot(), sampler)
    state.atlasGroup = bindGroup

    // How far the frame stands between the two backdrop photographs. One number
    // for the whole screen and the same one every glass pipeline's sharp tap
    // reads, so it is a uniform rather than a field on 54 floats of vertex —
    // and it rides the sharp tap's own group, because it is what says which of
    // that group's two images to believe. Four floats: `std140` rounds the
    // block to 16 bytes and the upload has to be that size.
    state.backdropBlend = uniformOrReport(graphics.createUniform(UniformDescriptor {
        label: "kira-ui-batch-backdrop-blend",
        expectedFloatCount: 4,
        data: [F32(0.0), F32(0.0), F32(0.0), F32(0.0)]
    }), "backdrop blend")

    // The external-texture fallback: the shader always declares that slot, and
    // until a TextureView registers a real texture the atlas satisfies it (mode-2
    // quads are only emitted once one has).
    let fallbackExternal = bindGroupOrReport(graphics.beginBindGroup("kira-ui-batch-external-fallback"), "fallback external")
    glassAddSharpBackdrop(graphics, fallbackExternal, atlas, atlas, sampler, state.backdropBlend)
    state.fallbackExternalGroup = fallbackExternal

    // Same discipline for the two blurred levels, which share one group: a frame
    // with no glass keeps both satisfied by the atlas.
    let fallbackSoftNear = bindGroupOrReport(graphics.beginBindGroup("kira-ui-batch-soft-near-fallback"), "fallback soft near")
    graphics.bindGroupAddTexture(fallbackSoftNear, backdropTextureSlot(), atlas)
    graphics.bindGroupAddSampler(fallbackSoftNear, backdropSamplerSlot(), sampler)
    graphics.bindGroupAddTexture(fallbackSoftNear, nearTextureSlot(), atlas)
    graphics.bindGroupAddSampler(fallbackSoftNear, nearSamplerSlot(), sampler)
    state.fallbackBackdropGroup = fallbackSoftNear

    var cacheKeySeed: [GlassSurfaceKey] = []
    while cacheKeySeed.count < glassCacheMaxSurfaces() {
        cacheKeySeed.append(GlassSurfaceKey())
    }
    state.glassCacheKeys = cacheKeySeed
    state.glassCacheKeySet = zeroedInts(glassCacheMaxSurfaces())
    state.glassCacheClaimed = zeroedInts(glassCacheMaxSurfaces())
    state.glyphHashKeys = zeroedInts(glyphCacheCapacity())
    state.glyphHashVals = zeroedInts(glyphCacheCapacity())

    state.probeQuads = environmentIsSet("KIRA_UI_QUAD_PROBE")
    state.probeCost = environmentIsSet("KIRA_UI_COST_PROBE")
    state.probeModes = environmentIsSet("KIRA_UI_MODE_PROBE")
    state.probeBatch = environmentIsSet("KIRA_UI_BATCH_PROBE")
    state.probeGlassLayers = environmentIsSet("KIRA_GLASS_LAYERS")
    state.probeGlassLayerOpen = environmentIsSet("KIRA_GLASS_LAYER_PROBE")
    state.layoutDebug = environmentIsSet("KIRA_UI_LAYOUT_DEBUG")
    state.benchFinalOnly = environmentIsSet("KIRA_GLASS_BENCH_FINAL_ONLY")
    state.benchBackgroundOnly = environmentIsSet("KIRA_GLASS_BENCH_BACKGROUND_ONLY")
    state.benchNoBackground = environmentIsSet("KIRA_GLASS_BENCH_NO_BACKGROUND")
    state.glassCacheDisabled = environmentIsSet("KIRA_GLASS_CACHE_OFF")

    loadBatchFont(state)

    return nativeState(state)
}
