import Foundation
import Ember
// What one frame of Liquid Glass cost the compositor, counted rather than
// inferred.
//
// The frame's own `statistics()` reports passes, draws and triangles for the
// whole frame, which cannot say whether a glass frame spent its time on forty
// surfaces or on one replayed forty times. These counters name the quantities
// the Liquid Glass architecture is judged on: how many surfaces were pushed,
// how many quads they expanded into, how many times the scene beneath them was
// replayed into a capture, and how many blur dispatches those captures cost.
//
// Every counter is reset by `beginBatch` and read after `presentBatch`, so a
// reading always describes exactly one frame.

// One frame's Liquid Glass workload.
public struct UiGlassFrameStats {
    // Glass surfaces the frame pushed: `pushGlass` calls past the degenerate-size
    // and no-stream rejections, whether or not the clip left any of them visible.
    var surfaces: Number = 0
    // Quads those surfaces expanded into, counted after the clip, so a surface
    // scrolled off screen adds to `surfaces` and nothing here. The ratio between
    // the two is the per-frame CPU geometry expansion.
    var patchQuads: Number = 0
    // Glass layers the frame cut itself into. Each one owns a capture and a
    // blur chain.
    var layers: Number = 0
    // Times the scene beneath a glass layer was drawn into that layer's capture
    // target. One per layer is the architectural target; one per capture region
    // is what a per-bound scissor loop costs.
    var captureReplays: Number = 0
    // Scissor regions those replays ran under.
    var captureRegions: Number = 0
    // Compute dispatches the blur pyramid cost.
    var blurDispatches: Number = 0
    // Output texels actually launched for the horizontal and vertical blur
    // kernels, including the horizontal stage's vertical-filter halo.
    var blurHorizontalTexels: Number = 0
    var blurVerticalTexels: Number = 0
    // Direct-backdrop blur reuse and opportunities, counted per presentation.
    var blurCacheHits: Number = 0
    var blurCacheMisses: Number = 0
    var staticBackdropLayers: Number = 0
    // Surfaces whose interior was presented from the cache, and surfaces that
    // shaded their interior live.
    var cachedInteriors: Number = 0
    var liveInteriors: Number = 0
}

extend UiBatchState {
    // Clear the emission counters. Called by `beginBatch`.
    //
    // Only the emission half: a re-presented frame never calls `beginBatch`, and
    // what it draws is the retained stream the last full frame emitted, so those
    // counts still describe the quads on screen. The presentation half is cleared
    // by `presentBatch`, which every frame runs.
    function resetGlassEmissionStats(borrow mut self) {
        // The last frame's rasterising, said as it is given up, so a log shows
        // the first frame of a screen filling the atlas and the next one
        // drawing every glyph from it.
        log debug("a frame rasterised glyphs", count: self.glyphsRasterised)
        self.glyphsRasterised = 0
        self.glassStatSurfaces = 0
        self.glassStatPatchQuads = 0
        self.glassStatCachedInteriors = 0
        self.glassStatLiveInteriors = 0
    }
}

// Where one frame's `presentBatch` spent its time, in nanoseconds.
//
// The four are a partition of the present phase: everything between entering
// `presentBatch` and leaving it falls in exactly one of them, so a reader who
// sums them gets the phase back and never has to wonder what the remainder was.
public struct UiBatchPhaseTimes {
    // GraphicsUniform, atlas and vertex-stream uploads: what the GPU must have before
    // the first pass reads it.
    var uploadNs: Number = 0
    // The per-layer scene passes that draw what sits beneath the glass into
    // that layer's capture target, plus the decision of whether a capture is
    // needed at all — a layer standing on a photograph takes neither.
    var captureNs: Number = 0
    // The blur pyramid: two compute dispatches per glass layer and the retile
    // that follows them.
    var blurNs: Number = 0
    // The interior-cache pass and the swapchain composite that ends the frame.
    var compositeNs: Number = 0
}

extend UiBatchState {
    // Clear the presentation counters. Called by `presentBatch`.
    function resetGlassPresentationStats(borrow mut self) {
        // The last frame's draw calls, said as they are given up: a screen of
        // text costs one, whatever else it draws.
        log debug("a frame drew", calls: self.drawCalls, text: self.textDrawCalls)
        self.drawCalls = 0
        self.textDrawCalls = 0
        self.glassStatLayers = 0
        self.glassStatCaptureReplays = 0
        self.glassStatCaptureRegions = 0
        self.glassStatBlurDispatches = 0
        self.glassStatBlurHorizontalTexels = 0
        self.glassStatBlurVerticalTexels = 0
        self.glassStatBlurCacheHits = 0
        self.glassStatBlurCacheMisses = 0
        self.glassStatStaticBackdropLayers = 0
        self.presentUploadNs = 0
        self.presentCaptureNs = 0
        self.presentBlurNs = 0
        self.presentCompositeNs = 0
    }
}

// This frame's Liquid Glass workload, as the compositor counted it.
extend UiBatch {
    function glassFrameStats() -> UiGlassFrameStats {
        var state = nativeRecover<UiBatchState>(self.storage)
        return UiGlassFrameStats {
            surfaces: state.glassStatSurfaces,
            patchQuads: state.glassStatPatchQuads,
            layers: state.glassStatLayers,
            captureReplays: state.glassStatCaptureReplays,
            captureRegions: state.glassStatCaptureRegions,
            blurDispatches: state.glassStatBlurDispatches,
            blurHorizontalTexels: state.glassStatBlurHorizontalTexels,
            blurVerticalTexels: state.glassStatBlurVerticalTexels,
            blurCacheHits: state.glassStatBlurCacheHits,
            blurCacheMisses: state.glassStatBlurCacheMisses,
            staticBackdropLayers: state.glassStatStaticBackdropLayers,
            cachedInteriors: state.glassStatCachedInteriors,
            liveInteriors: state.glassStatLiveInteriors
        }
    }
}

// Where the frame just presented spent the present phase.
extend UiBatch {
    function presentPhaseTimes() -> UiBatchPhaseTimes {
        var state = nativeRecover<UiBatchState>(self.storage)
        return UiBatchPhaseTimes {
            uploadNs: state.presentUploadNs,
            captureNs: state.presentCaptureNs,
            blurNs: state.presentBlurNs,
            compositeNs: state.presentCompositeNs
        }
    }
}
