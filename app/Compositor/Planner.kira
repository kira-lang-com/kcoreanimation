import Foundation

// Lowering the retained tree into a render plan.
//
// A recursive walk over (node, target-pass) frames, carrying the growing plan as
// a `borrow mut` accumulator. A node normally emits one draw command into its
// current pass and hands its own effective opacity to its children (ordinary
// opacity inheritance). A GROUP-OPACITY node instead opens its own pass, draws
// its whole subtree into it at full alpha, and emits a single COMPOSITE command
// into the parent pass at the group alpha — so overlapping children blend once,
// inside the group, and the group fades as one. Folding the alpha into each child
// (the wrong thing) is exactly what this avoids. A render-target node opens a
// pass targeting a texture the same way.
//
// A DEFORMED node -- glass pulled by a press -- draws its own content in place
// at the deformed geometry, and opens a pass for what it holds, drawn at rest:
// the composite carries that picture through the deformation, so the text on
// the glass stretches with it as an image instead of being laid out afresh at
// every frame's shape, and while only the deformation changes the pass is not
// dirty and its texture is reused.
//
// Overlays are walked from the canvas root, unclipped, after the root subtree —
// a hoisted menu escapes its ancestors' clips.

public @Derive(Copy)
struct CAPlanFrame {
    var id: LayerId = LayerId(0)
    var pass: RenderPassId = RenderPassId(0)
    var world: CAAffineTransform = CAAffineTransform {}
    var opacity: Float = 1.0
    var clipMinX: Float = 0.0
    var clipMinY: Float = 0.0
    var clipMaxX: Float = 1000000.0
    var clipMaxY: Float = 1000000.0
    var clipRadius: Float = 0.0
    var clipShapeKind: Int = 0
    var glassWash: Float = 0.0
    var glassWashLuma: Float = 1.0
}

public function caPlanUnclipped(id: LayerId, pass: RenderPassId) -> CAPlanFrame {
    return CAPlanFrame { id: id, pass: pass }
}

public function caNodeDrawCmd(node: borrow CALayerNode, at: borrow CAAffineTransform, opacity: Float, frame: borrow CAPlanFrame) -> CADrawCmd {
    // Drawn where its platter is, which is its own box unless a press is
    // still sliding onto it.
    let world = caConcat(at, caTranslation(node.platterX.presentation, node.platterY.presentation))
    let w = node.boundsW.presentation + node.platterW.presentation
    let h = node.boundsH.presentation + node.platterH.presentation
    let lengthScale = caLengthScale(world)
    return CADrawCmd {
        layer: node.id,
        kind: caContentKind(node.content),
        content: node.content,
        quad: caOrientedQuad(world, w, h),
        worldBounds: caApplyRect(world, Rect { x: 0.0, y: 0.0, width: w, height: h }),
        localWidth: w,
        localHeight: h,
        opacity: opacity,
        fill: caColorChannelPresentation(node.fillColor),
        border: caColorChannelPresentation(node.borderColor),
        cornerRadius: node.cornerRadius.presentation * lengthScale,
        borderWidth: node.borderWidth.presentation * lengthScale,
        lengthScale: lengthScale,
        textScale: caTextScale(world),
        textWeight: node.textWeight.presentation,
        glassWash: frame.glassWash,
        glassWashLuma: frame.glassWashLuma,
        capturesBackdrop: node.capturesBackdrop,
        clipMinX: frame.clipMinX,
        clipMinY: frame.clipMinY,
        clipMaxX: frame.clipMaxX,
        clipMaxY: frame.clipMaxY,
        clipRadius: frame.clipRadius,
        clipShapeKind: frame.clipShapeKind,
        sourcePass: .None,
        hit: node.hit,
        hitKey: node.hitKey
    }
}

public function caNodeHasShadow(node: borrow CALayerNode) -> Bool {
    let color = caColorChannelPresentation(node.shadowColor)
    return node.shadowOpacity.presentation > 0.0 && color.a > 0.0
}

public function caShadowCmd(node: borrow CALayerNode, world: borrow CAAffineTransform, opacity: Float, frame: borrow CAPlanFrame) -> CADrawCmd {
    let width = node.boundsW.presentation
    let height = node.boundsH.presentation
    let lengthScale = caLengthScale(world)
    let blur = max(node.shadowRadius.presentation * lengthScale, 0.0)
    let localOffsetX = node.shadowX.presentation
    let localOffsetY = node.shadowY.presentation
    let offsetX = world.a * localOffsetX + world.c * localOffsetY
    let offsetY = world.b * localOffsetX + world.d * localOffsetY
    var quad = caOrientedQuad(world, width, height)
    quad.centerX = quad.centerX + offsetX
    quad.centerY = quad.centerY + offsetY
    let base = caApplyRect(world, Rect { x: 0.0, y: 0.0, width: width, height: height })
    let pad = blur * 1.5 + 1.0
    return CADrawCmd {
        layer: node.id,
        kind: caShadowKind(),
        content: .Empty,
        quad: quad,
        worldBounds: Rect {
            x: base.x + offsetX - pad,
            y: base.y + offsetY - pad,
            width: base.width + pad * 2.0,
            height: base.height + pad * 2.0
        },
        localWidth: width,
        localHeight: height,
        opacity: opacity * node.shadowOpacity.presentation,
        fill: caColorChannelPresentation(node.shadowColor),
        cornerRadius: node.cornerRadius.presentation * lengthScale,
        shadowRadius: blur,
        shadowOffset: Point { x: offsetX, y: offsetY },
        shadowKnockout: node.capturesBackdrop,
        shapeKind: caContentShapeKind(node.content),
        lengthScale: lengthScale,
        clipMinX: frame.clipMinX,
        clipMinY: frame.clipMinY,
        clipMaxX: frame.clipMaxX,
        clipMaxY: frame.clipMaxY,
        clipRadius: frame.clipRadius,
        clipShapeKind: frame.clipShapeKind,
        sourcePass: .None
    }
}

public function caCompositeCmd(layer: LayerId, bounds: borrow Rect, opacity: Float, frame: borrow CAPlanFrame, sourcePass: RenderPassId) -> CADrawCmd {
    return CADrawCmd {
        layer: layer,
        kind: caCompositeKind(),
        content: .Empty,
        quad: CAOrientedQuad {
            centerX: bounds.x + bounds.width / 2.0,
            centerY: bounds.y + bounds.height / 2.0,
            halfW: bounds.width / 2.0,
            halfH: bounds.height / 2.0
        },
        worldBounds: bounds,
        opacity: opacity,
        clipMinX: frame.clipMinX,
        clipMinY: frame.clipMinY,
        clipMaxX: frame.clipMaxX,
        clipMaxY: frame.clipMaxY,
        clipRadius: frame.clipRadius,
        clipShapeKind: frame.clipShapeKind,
        sourcePass: .Some(sourcePass)
    }
}

// Presentation state inherited by a node's children: world transform, clip, and
// the enclosing glass wash adaptive text must measure against.
public function caPlanChildFrame(node: borrow CALayerNode, frame: borrow CAPlanFrame, world: borrow CAAffineTransform) -> CAPlanFrame {
    var out = frame
    out.world = world
    if node.clip {
        let box = caApplyRect(world, Rect { x: 0.0, y: 0.0, width: node.boundsW.presentation, height: node.boundsH.presentation })
        out.clipMinX = max(frame.clipMinX, box.x)
        out.clipMinY = max(frame.clipMinY, box.y)
        out.clipMaxX = min(frame.clipMaxX, box.x + box.width)
        out.clipMaxY = min(frame.clipMaxY, box.y + box.height)
        out.clipRadius = node.cornerRadius.presentation * caLengthScale(world)
        out.clipShapeKind = caContentShapeKind(node.content)
    }
    match node.content {
        Glass(glass) -> {
            let wash = caGlassWash(caColorChannelPresentation(node.fillColor), glass.material)
            out.glassWash = wash.alpha
            out.glassWashLuma = wash.luma
        }
        Empty -> {}
        Solid(s) -> {}
        Text(t) -> {}
        Texture(t) -> {}
        Icon(i) -> {}
        Gradient(g) -> {}
    }
    return out
}

public function caPlanNode(tree: borrow CALayerTree, frame: borrow CAPlanFrame, plan: borrow mut CARenderPlan) {
    var idx = LayerSlot(0)
    match tree.nodeSlot(frame.id) {
        None -> { return }
        Some(slot) -> { idx = slot }
    }
    if !tree.nodes[idx.raw].mounted {
        return
    }
    caPlanLayer(tree, tree.nodes[idx.raw], frame, plan)
    return
}

// Plans one mounted layer and what it holds. The node is borrowed where it
// stands in the tree: a node is a large value, and a copy of each one per
// frame was a good part of planning it.
public function caPlanLayer(tree: borrow CALayerTree, node: borrow CALayerNode, frame: borrow CAPlanFrame, plan: borrow mut CARenderPlan) {
    let rest = caConcat(frame.world, caLocalTransform(node))
    let world = caConcat(rest, caDeformTransform(node))
    let eff = frame.opacity * node.opacity.presentation
    // A group at full opacity looks the same drawn in place, so it is.
    let isGroup = node.groupOpacity && node.opacity.presentation < 1.0 && node.childIds.count > 0
    let isTarget = node.renderTarget && node.childIds.count > 0
    let isBlurred = node.blur > 0.0 && node.childIds.count > 0
    // What a deformed layer holds goes into a picture, unless some of it is
    // ink burned or dodged into the glass -- a picture drawn apart has no
    // glass under it to burn into, and the ink would be lost -- in which case
    // it is drawn live through the deformation, as glass is.
    let isDeformed = !caDeformationIsIdentity(node.deformation) && node.childIds.count > 0 && !caPlanInksIntoBackdrop(tree, node)
    let childFrame = caPlanChildFrame(node, frame, isDeformed ? rest : world)

    if isGroup || isTarget || isBlurred || isDeformed {
        let newPass = RenderPassId(plan.passes.count)
        var kind: CAPassKind = .GroupOpacity
        var targetId = RenderTargetId(0)
        if isTarget {
            kind = .RenderTarget
            targetId = node.renderTargetId
        }
        plan.passes.append(CAPass {
            kind: kind,
            passId: newPass,
            owner: node.id,
            targetId: targetId,
            groupOpacity: eff
        })
        // Deformed, the layer's own content is drawn live where the
        // deformation puts it -- glass refracts what is really behind it --
        // and only what it holds goes into the picture.
        let own = isDeformed ? frame.pass : newPass
        let ownOpacity = isDeformed ? eff : 1.0
        if caNodeHasShadow(node) {
            caPlanEmit(plan, own, caShadowCmd(node, world, ownOpacity, frame), node.damaged)
        }
        caPlanEmit(plan, own, caNodeDrawCmd(node, world, ownOpacity, frame), node.damaged)
        for childId in node.childIds {
            var cidx = LayerSlot(0)
            match tree.nodeSlot(childId) {
                None -> { continue }
                Some(slot) -> { cidx = slot }
            }
            if tree.nodes[cidx.raw].mounted && !tree.nodes[cidx.raw].hoisted {
                // Glass held by a deformed layer refracts what is really
                // behind it, so it is drawn live and deformed, as the layer's
                // own content is, rather than into the picture.
                if isDeformed && tree.nodes[cidx.raw].capturesBackdrop {
                    let deformed = caPlanChildFrame(node, frame, world)
                    let live = deformed {
                        let id = childId
                        let opacity = eff
                    }
                    caPlanNode(tree, live, plan)
                    continue
                }
                let cf = childFrame {
                    let id = childId
                    let pass = newPass
                    let opacity = 1.0
                }
                caPlanNode(tree, cf, plan)
            }
        }
        // A blurred tree spreads past what it painted, so its texture is
        // held open by the blur's reach on every side.
        let p = newPass.raw
        if isBlurred && plan.passes[p].hasBounds {
            let reach = node.blur * caLengthScale(world)
            let held = plan.passes[p].bounds
            plan.passes[p].bounds = Rect {
                x: held.x - reach,
                y: held.y - reach,
                width: held.width + reach * 2.0,
                height: held.height + reach * 2.0
            }
        }
        if plan.passes[p].hasBounds {
            let isolatedBounds = plan.passes[p].bounds
            let shown = isDeformed ? caApplyRect(caDeformAcross(rest, node), isolatedBounds) : isolatedBounds
            var composite = caCompositeCmd(node.id, shown, eff, frame, newPass)
            composite.blur = isBlurred ? node.blur * caLengthScale(world) : 0.0
            let dirty = plan.passes[p].dirty || node.damaged
            let refresh = plan.passes[p].requiresRefresh
            caPlanEmit(plan, frame.pass, move composite, dirty)
            if refresh {
                plan.passes[frame.pass.raw].requiresRefresh = true
            }
        }
        return
    }

    if caNodeHasShadow(node) {
        caPlanEmit(plan, frame.pass, caShadowCmd(node, world, eff, frame), node.damaged)
    }
    caPlanEmit(plan, frame.pass, caNodeDrawCmd(node, world, eff, frame), node.damaged)
    for childId in node.childIds {
        var cidx = LayerSlot(0)
        match tree.nodeSlot(childId) {
            None -> { continue }
            Some(slot) -> { cidx = slot }
        }
        if tree.nodes[cidx.raw].mounted && !tree.nodes[cidx.raw].hoisted {
            let cf = childFrame {
                let id = childId
                let opacity = eff
            }
            caPlanNode(tree, cf, plan)
        }
    }
    return
}

public function caPlan(tree: borrow CALayerTree) -> CARenderPlan {
    var plan = CARenderPlan {}
    if tree.rootId == LayerId(0) {
        return plan
    }
    plan.passes.append(CAPass { kind: .Root, passId: RenderPassId(0) })
    caPlanNode(tree, caPlanUnclipped(tree.rootId, RenderPassId(0)), plan)
    for overlayId in caOrderedOverlays(tree) {
        caPlanNode(tree, caPlanUnclipped(overlayId, RenderPassId(0)), plan)
    }
    return plan
}

// Whether anything `node` holds inks by burning or dodging what is under it,
// as a symbol set into glass does.
public function caPlanInksIntoBackdrop(tree: borrow CALayerTree, node: borrow CALayerNode) -> Bool {
    for childId in node.childIds {
        match tree.nodeSlot(childId) {
            None -> { continue }
            Some(slot) -> {
                match tree.nodes[slot.raw].content {
                    Icon(icon) -> {
                        if icon.blend != .Normal {
                            return true
                        }
                    }
                    Empty -> {}
                    Solid(s) -> {}
                    Text(t) -> {}
                    Texture(x) -> {}
                    Glass(g) -> {}
                    Gradient(g) -> {}
                }
                if caPlanInksIntoBackdrop(tree, tree.nodes[slot.raw]) {
                    return true
                }
            }
        }
    }
    return false
}
