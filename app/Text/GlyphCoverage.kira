import Foundation

// A glyph outline scan-converted into antialiased coverage, exactly: each
// edge adds the signed area it covers in every pixel it crosses to an
// accumulation buffer, and a running sum along each row turns those into how
// much of each pixel the shape covers, nonzero winding. No sub-samples, so a
// stem's edge carries its true partial coverage wherever it falls.
//
// Unhinted, the way Apple draws text: the outline is drawn where the designer
// put it, and the caller shifts it by the fraction of a pixel the pen stands
// at, so a run is evenly spaced rather than snapped (see `glyphPhaseOf`).

struct GlyphBitmap {
    let width: Number
    let rows: Number
    // The bitmap's left edge from the pen, and its top edge above the
    // baseline, in whole pixels.
    let left: Number
    let top: Number
    // The pen's advance past this glyph, in pixels.
    let advance: Number
    // Coverage, 0 to 255, `width` to a row, top row first.
    let levels: [UN8]
}

// The whole pixels an outline's control points reach: left and right edges,
// and top and bottom above the baseline.
struct PixelBox {
    let left: Number
    let right: Number
    let top: Number
    let bottom: Number
}

namespace CoverageCurve {
    // A curve this close to its chord, squared, in pixels, is drawn as the
    // chord.
    let flat: Float = 0.333
    // How finely a curve is cut: more segments the further it bows.
    let tolerance: Float = 3.0
    let opaque: Float = 255
}

// An outline in pixels: x right from the pen, y up from the baseline.
struct PlacedOutline {
    let shape: GlyphPoints
    let scale: Float
    let shift: Float

    function x(borrow self, point: borrow OutlinePoint) -> Float {
        return point.x * scale + shift
    }

    function y(borrow self, point: borrow OutlinePoint) -> Float {
        return point.y * scale
    }

    // The box FreeType presets a bitmap to: the control box, grown to whole
    // pixels. Nothing for an outline with no points, as a space has none.
    function box(borrow self) -> PixelBox? {
        if shape.points.count == 0 { return .None }
        let first = shape.points[0]
        var left = x(first)
        var right = left
        var bottom = y(first)
        var top = bottom
        for point in shape.points {
            left = min(left, x(point))
            right = max(right, x(point))
            bottom = min(bottom, y(point))
            top = max(top, y(point))
        }
        let box = PixelBox {
            left: Number(floor(left)),
            right: Number(ceil(right)),
            top: Number(ceil(top)),
            bottom: Number(floor(bottom))
        }
        if box.right <= box.left || box.top <= box.bottom { return .None }
        return .Some(box)
    }
}

// The accumulation buffer one glyph is drawn into. It is one cell longer
// than the bitmap at each end of a row's reach, because an edge on the
// right border adds its remainder one cell past it.
struct CoverageCells {
    let width: Number
    let rows: Number
    var cells: [Float]

    function line(borrow mut self, fromX: Float, fromY: Float, toX: Float, toY: Float) {
        if fromY == toY { return }
        let downward = fromY < toY
        let direction: Float = downward ? 1.0 : -1.0
        let (x0, y0, x1, y1) = downward ? (fromX, fromY, toX, toY) : (toX, toY, fromX, fromY)
        let slope = (x1 - x0) / (y1 - y0)
        var x = x0
        if y0 < 0.0 { x -= y0 * slope }
        let first = Number(max(floor(y0), 0.0))
        let last = Number(min(Float(rows), ceil(y1)))
        for row in first..last {
            let rowY = Float(row)
            let height = min(rowY + 1.0, y1) - max(rowY, y0)
            let next = x + slope * height
            spanCells(row * width, x, next, height * direction)
            x = next
        }
    }

    // One row's share of an edge running from `x` to `next` across it,
    // `area` the signed height it covers.
    function spanCells(borrow mut self, rowStart: Number, x: Float, next: Float, area: Float) {
        let (low, high) = x < next ? (x, next) : (next, x)
        let lowFloor = floor(low)
        let lowCell = Number(lowFloor)
        let highCell = Number(ceil(high))
        if highCell <= lowCell + 1 {
            let middle = 0.5 * (x + next) - lowFloor
            cells[rowStart + lowCell] += area - area * middle
            cells[rowStart + lowCell + 1] += area * middle
            return
        }
        let reciprocal = 1.0 / (high - low)
        let lowFraction = low - lowFloor
        let lowArea = 0.5 * reciprocal * (1.0 - lowFraction) * (1.0 - lowFraction)
        let highFraction = high - Float(highCell) + 1.0
        let highArea = 0.5 * reciprocal * highFraction * highFraction
        cells[rowStart + lowCell] += area * lowArea
        if highCell == lowCell + 2 {
            cells[rowStart + lowCell + 1] += area * (1.0 - lowArea - highArea)
        } else {
            let secondArea = reciprocal * (1.5 - lowFraction)
            cells[rowStart + lowCell + 1] += area * (secondArea - lowArea)
            for cell in (lowCell + 2)..(highCell - 1) {
                cells[rowStart + cell] += area * reciprocal
            }
            let beforeLast = secondArea + Float(highCell - lowCell - 3) * reciprocal
            cells[rowStart + highCell - 1] += area * (1.0 - beforeLast - highArea)
        }
        cells[rowStart + highCell] += area * highArea
    }

    function curve(
        borrow mut self,
        from: borrow OutlineVector,
        control: borrow OutlineVector,
        to: borrow OutlineVector
    ) {
        let bowX = from.x - 2.0 * control.x + to.x
        let bowY = from.y - 2.0 * control.y + to.y
        let bow = bowX * bowX + bowY * bowY
        if bow < CoverageCurve.flat {
            line(from.x, from.y, to.x, to.y)
            return
        }
        let segments = 1 + Number(floor(sqrt(sqrt(CoverageCurve.tolerance * bow))))
        var lastX = from.x
        var lastY = from.y
        for step in 1..(segments + 1) {
            let t = Float(step) / Float(segments)
            let inverse = 1.0 - t
            let nextX = inverse * inverse * from.x + 2.0 * inverse * t * control.x + t * t * to.x
            let nextY = inverse * inverse * from.y + 2.0 * inverse * t * control.y + t * t * to.y
            line(lastX, lastY, nextX, nextY)
            lastX = nextX
            lastY = nextY
        }
    }

    // The running sum of every row, as coverage levels.
    function levels(borrow self) -> [UN8] {
        var levels: [UN8] = []
        var sum: Float = 0.0
        for index in 0..(width * rows) {
            sum += cells[index]
            let level = trunc(min(abs(sum), 1.0) * CoverageCurve.opaque + 0.5)
            levels.append(UN8(Number(level)))
        }
        return levels
    }
}

extend PlacedOutline {
    // The outline drawn into `box`, as coverage.
    function coverage(borrow self, box: borrow PixelBox) -> [UN8] {
        let width = box.right - box.left
        let rows = box.top - box.bottom
        var cells = CoverageCells { width: width, rows: rows, cells: filled(width * rows + 2, 0.0) }
        var first: Number = 0
        for end in shape.ends {
            if end >= first && end < shape.points.count { drawContour(cells, box, first, end) }
            first = end + 1
        }
        return cells.levels()
    }

    // A point in the bitmap: x right from its left edge, y down from its top.
    function cell(borrow self, point: borrow OutlinePoint, box: borrow PixelBox) -> OutlineVector {
        return OutlineVector { x: x(point) - Float(box.left), y: Float(box.top) - y(point) }
    }

    // One quadratic contour. Two off-curve points in a row have an implied
    // on-curve point midway between them; a contour of only off-curve points
    // starts at the one between its last and first.
    function drawContour(
        cells: borrow mut CoverageCells,
        box: borrow PixelBox,
        first: Number,
        end: Number
    ) {
        let count = end - first + 1
        let (start, from, to) = contourStart(box, first, end)
        var pen = start
        var control: OutlineVector? = .None
        for step in from..to {
            let point = shape.points[first + (step % count)]
            let here = cell(point, box)
            match control {
                Some(bend) -> {
                    if point.onCurve {
                        cells.curve(pen, bend, here)
                        pen = here
                        control = .None
                    } else {
                        let middle = OutlineVector {
                            x: (bend.x + here.x) / 2.0,
                            y: (bend.y + here.y) / 2.0
                        }
                        cells.curve(pen, bend, middle)
                        pen = middle
                        control = .Some(here)
                    }
                }
                None -> {
                    if point.onCurve {
                        cells.line(pen.x, pen.y, here.x, here.y)
                        pen = here
                    } else {
                        control = .Some(here)
                    }
                }
            }
        }
        match control {
            Some(bend) -> cells.curve(pen, bend, start)
            None -> cells.line(pen.x, pen.y, start.x, start.y)
        }
    }

    // Where a contour starts, and the steps around it the walk takes: from
    // its first on-curve point once around the rest, or, when no point is on
    // it, from the midpoint between its last and first points through all.
    function contourStart(borrow self, box: borrow PixelBox, first: Number, end: Number) -> (
        OutlineVector,
        Number,
        Number
    ) {
        let count = end - first + 1
        for offset in 0..count {
            let point = shape.points[first + offset]
            if point.onCurve { return (cell(point, box), offset + 1, offset + count) }
        }
        let last = cell(shape.points[end], box)
        let head = cell(shape.points[first], box)
        return (OutlineVector { x: (last.x + head.x) / 2.0, y: (last.y + head.y) / 2.0 }, 0, count)
    }
}

extend FontFile {
    // `glyph` at `coordinates`, `scale` pixels to the font unit, shifted
    // right by `shift` pixels before it is scan-converted.
    function glyphBitmap(
        glyph: GlyphId,
        coordinates: borrow [Float],
        scale: Float,
        shift: Float
    ) -> GlyphBitmap {
        let outline = glyphOutline(glyph, coordinates)
        let advance = Number(outline.advance * scale)
        let placed = PlacedOutline { shape: move outline.shape, scale: scale, shift: shift }
        return match placed.box() {
            Some(box) -> GlyphBitmap {
                width: Number(box.right - box.left),
                rows: Number(box.top - box.bottom),
                left: Number(box.left),
                top: Number(box.top),
                advance: advance,
                levels: placed.coverage(box)
            }
            None -> GlyphBitmap { width: 0, rows: 0, left: 0, top: 0, advance: advance, levels: [] }
        }
    }

    // The pixels `glyph` would cover, without drawing it.
    function glyphBox(glyph: GlyphId, coordinates: borrow [Float], scale: Float) -> PixelBox? {
        let outline = glyphOutline(glyph, coordinates)
        let placed = PlacedOutline { shape: move outline.shape, scale: scale, shift: 0.0 }
        return placed.box()
    }
}
