import Foundation

// Measuring runs, shaped as they are drawn: their advance, the face's line metrics, and their visible
// ink, each from the instance the compositor draws the run with.

extend TextEngine {
    // A run's advance in pixels, set at `size` pixels for text of `points`:
    // each glyph's, in order.
    function runWidth(
        borrow mut self,
        design: borrow CAFontDesign,
        text: borrow String,
        size: Number,
        points: Number,
        weight: Number,
        spacing: Number = 0.0,
        trailingSpacing: Bool = false,
        widthRatio: Number = 1.0
    ) -> Number {
        let font = match face(design) {
            Some(font) -> font
            None -> return 0
        }
        let instance = instance(font, size, points, weight, design == .MonospacedDigits, widthRatio)
        let key = "\(instance.key) \(text)"
        match runs.value(key) {
            Some(known) -> return max(0.0, known + runExtraSpacing(
                instance, text, spacing, trailingSpacing
            ))
            None -> {}
        }
        var width: Number = 0
        for shaped in shapedRun(instance, text) {
            width += shaped.advance
        }
        if runs.count() >= TextCache.runs { runs.removeAll() }
        runs.set(move key, width)
        return max(0.0, width + runExtraSpacing(
            instance, text, spacing, trailingSpacing
        ))
    }

    // A shaped cluster is the unit to which KCoreAnimation's GPOS marks and
    // ligatures attach. Apply letter spacing BETWEEN clusters, never between
    // glyphs belonging to one cluster (e.g. a letter with a combining mark).
    // SwiftUI tracking additionally reserves a final space after the last
    // cluster. Kerning does not reserve that final advance.
    function runExtraSpacing(
        borrow mut self,
        instance: borrow FaceInstance,
        text: borrow String,
        spacing: Number,
        trailingSpacing: Bool
    ) -> Number {
        if spacing == 0.0 { return 0.0 }
        let run = shapedRun(instance, text)
        var clusters: Number = 0
        var previous: Number = -1
        for glyph in run {
            if glyph.cluster != previous {
                clusters++
                previous = glyph.cluster
            }
        }
        let gaps = trailingSpacing ? clusters : max(clusters - 1.0, 0.0)
        return spacing * gaps
    }

    // The instance a run in `design` at `size` pixels for text of `points`,
    // and `weight`, is drawn with.
    function runInstance(
        borrow mut self,
        design: borrow CAFontDesign,
        size: Number,
        points: Number,
        weight: Number,
        widthRatio: Number = 1.0
    ) -> FaceInstance? {
        return match face(design) {
            Some(font) -> .Some(instance(
                font, size, points, weight, design == .MonospacedDigits, widthRatio
            ))
            None -> .None
        }
    }

    // A run's visible ink, measured at four times its size so a fraction of
    // a pixel survives being divided back down; nothing for a run with no ink.
    function runInk(
        borrow mut self,
        design: borrow CAFontDesign,
        text: borrow String,
        size: Number,
        points: Number,
        weight: Number,
        widthRatio: Number = 1.0
    ) -> TextInk? {
        if text.count == 0 || size <= 0 { return .None }
        let font = match face(design) {
            Some(font) -> font
            None -> return .None
        }
        let step = TextCache.inkWeightStep
        let instance = instance(
            font,
            size * TextCache.inkScale,
            points,
            round(weight / step) * step,
            design == .MonospacedDigits,
            widthRatio
        )
        let key = "\(instance.key) \(text)"
        match inks.value(key) {
            Some(known) -> return known
            None -> {}
        }
        let ink = inkOf(instance, text)
        if inks.count() >= TextCache.inks { inks.removeAll() }
        inks.set(move key, copy ink)
        return ink
    }

    function inkOf(
        borrow mut self,
        instance: borrow FaceInstance,
        text: borrow String
    ) -> TextInk? {
        let font = fonts[instance.font.raw]
        let scale = TextCache.inkScale
        var pen: Number = 0
        var found: TextInk? = .None
        var lead: Number = 0
        for shaped in shapedRun(instance, text) {
            let glyph = shaped.glyph
            let glyphX = pen + shaped.offset
            pen += shaped.advance
            let box = match font.glyphBox(glyph, instance.coordinates, instance.scale) {
                Some(box) -> box
                None -> continue
            }
            let left = glyphX + Number(box.left)
            let right = glyphX + Number(box.right)
            let glyphInk = TextInk {
                left: left,
                right: right,
                top: Number(box.top) + shaped.rise,
                bottom: Number(box.bottom) + shaped.rise
            }
            match found {
                Some(ink) -> found = .Some(ink.joined(glyphInk))
                None -> {
                    lead = glyphX
                    found = .Some(glyphInk)
                }
            }
        }
        return match found {
            Some(ink) -> .Some(
                TextInk {
                    left: (ink.left - lead) / scale,
                    right: ink.right / scale,
                    top: ink.top / scale,
                    bottom: -ink.bottom / scale
                }
            )
            None -> .None
        }
    }
}

extend TextInk {
    // The ink of both, in one box.
    function joined(borrow self, other: borrow TextInk) -> TextInk {
        return TextInk {
            left: min(left, other.left),
            right: max(right, other.right),
            top: max(top, other.top),
            bottom: min(bottom, other.bottom)
        }
    }
}
