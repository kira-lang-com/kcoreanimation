import Foundation

// The retained layer tree: stable handles, a model/presentation value per
// animatable channel, a nested-transaction stack, damage bits, and a keyed
// reconcile. The tree is a real owned value the caller HOLDS across frames — it
// is not rebuilt each frame and it does not hide behind a native handle. A
// `LayerId` names a node for the tree's whole life; the node behind it is found
// through a dense id->slot index so a lookup is O(1) and never a scan.
//
// Time is absolute: the tree carries a clock, every set stamps a channel with
// it, and a frame samples every channel at the clock reading it was handed. The
// delta form (`advance`) is the clock advanced by dt and then sampled.

public distinct LayerId = Number

public namespace Layers {
    let none: LayerId = LayerId(0)
}

// Where a layer draws in the z order. `Inline` draws in tree order under its
// ancestors' clips. `Overlay(level)` escapes every ancestor clip and draws from
// the canvas root, ordered by level (lower first), after all inline content —
// the semantic hoist a menu, popover or dialog needs.
public function duplicateLayerKeyTrap(key: Number) {
    print(
        "KCoreAnimation: duplicate sibling layer key " + String(
            key
        ) + " is ambiguous and is not allowed"
    )
    let ignored = "duplicate-layer-key".charAt("duplicate-layer-key".count)
}

public struct CALayerTree {
    var nodes: [CALayerNode] = []
    var indexOfId: [LayerSlot?] = []
    var nextId: LayerId = LayerId(1)
    var rootId: LayerId = LayerId(0)
    var txStack: [CATiming] = []
    var overlays: [LayerId] = []
    var moving: Bool = false
    var teardownCount: Number = 0
    // Absolute clock, in seconds. Sets stamp channels with it; a frame samples
    // every channel at it. Fed from the graphics monotonic clock by the runner.
    var clock: Number = 0.0
    // The layer the pointer is over, or none. Its fill shows its hover wash.
    var hoveredId: LayerId = LayerId(0)
    // The layer held down, or none. Its fill shows its press wash while the
    // pointer is on it.
    var pressedId: LayerId = LayerId(0)
    function nodeSlot(id: LayerId) -> LayerSlot? {
        if id.raw <= 0 || id.raw >= self.indexOfId.count { return .None }
        return self.indexOfId[id.raw]
    }

    // --- construction ------------------------------------------------------

    function makeLayer(parent: LayerId, key: Number, content: CAContent) -> LayerId {
        if parent != LayerId(0) && key != 0 {
            match self.nodeSlot(parent) {
                Some(parentSlot) -> {
                    for childId in self.nodes[parentSlot.raw].childIds {
                        match self.nodeSlot(childId) {
                            Some(childSlot) -> {
                                if self.nodes[childSlot.raw].mounted && self.nodes[childSlot.raw].key == key {
                                    duplicateLayerKeyTrap(key)
                                }
                            }
                            None -> {}
                        }
                    }
                }
                None -> {}
            }
        }
        let newId = self.nextId
        self.nextId = LayerId(self.nextId.raw + 1)
        let signature = content.signature()
        var node = CALayerNode {
            id: newId,
            parentId: parent,
            key: key,
            content: move content,
            contentSignature: signature,
            reused: true
        }
        let index = self.nodes.count
        self.nodes.append(move node)
        while self.indexOfId.count <= newId.raw {
            self.indexOfId.append(.None)
        }
        self.indexOfId[newId.raw] = .Some(LayerSlot(index))
        self.nodes[index].initAppearanceFromContent()
        if parent == LayerId(0) {
            self.rootId = newId
        } else {
            match self.nodeSlot(parent) {
                Some(pidx) -> {
                    self.nodes[pidx.raw].childIds.append(newId)
                }
                None -> {}
            }
        }
        return newId
    }

    // --- transactions ------------------------------------------------------

    function beginTransaction(timing: CATiming) {
        self.txStack.append(move timing)
    }

    function commitTransaction() {
        if self.txStack.count > 0 {
            var shorter: [CATiming] = []
            let keep = self.txStack.count - 1
            for i in 0..keep {
                shorter.append(self.txStack[i])
            }
            self.txStack = move shorter
        }
    }

    // The action a set fires under: the innermost open transaction, or the
    // default 0.25s ease-out when none is open.
    function currentTiming() -> CATiming {
        if self.txStack.count == 0 {
            return defaultTiming()
        }
        return self.txStack[self.txStack.count - 1]
    }

    // --- animatable setters (idiomatic method surface) ---------------------

    function setPosition(id: LayerId, x: Number, y: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        let changedX = self.nodes[idx.raw].posX.applyTiming(timing, x, self.clock)
        let changedY = self.nodes[idx.raw].posY.applyTiming(timing, y, self.clock)
        if changedX || changedY {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setBounds(id: LayerId, width: Number, height: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        let changedW = self.nodes[idx.raw].boundsW.applyTiming(timing, width, self.clock)
        let changedH = self.nodes[idx.raw].boundsH.applyTiming(timing, height, self.clock)
        if changedW || changedH {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setFrame(id: LayerId, x: Number, y: Number, width: Number, height: Number) {
        self.setPosition(id, x, y)
        self.setBounds(id, width, height)
    }

    function setOpacity(id: LayerId, value: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].opacity.applyTiming(timing, value, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setScale(id: LayerId, scaleX: Number, scaleY: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        let changedX = self.nodes[idx.raw].scaleX.applyTiming(timing, scaleX, self.clock)
        let changedY = self.nodes[idx.raw].scaleY.applyTiming(timing, scaleY, self.clock)
        if changedX || changedY {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setDeformation(id: LayerId, deformation: borrow CADeformation) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let was = self.nodes[idx.raw].deformation
        if was.x != deformation.x || was.y != deformation.y || was.scaleX != deformation.scaleX || was.scaleY != deformation.scaleY {
            self.nodes[idx.raw].deformation = copy deformation
            self.nodes[idx.raw].damaged = true
        }
    }

    function setRotation(id: LayerId, radians: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].rotation.applyTiming(timing, radians, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    // --- animatable appearance ---------------------------------------------

    function setFillColor(id: LayerId, color: CAColor) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        self.nodes[idx.raw].restingFill = color
        if self.nodes[idx.raw].fillColor.applyTiming(
            timing,
            self.nodes[idx.raw].shownFill(id == self.hoveredId, id == self.pressedId),
            self.clock
        ) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setHoverColor(id: LayerId, color: CAColor) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].hoverColor.same(color) {
            return
        }
        self.nodes[idx.raw].hoverColor = color
        self.relight(id)
    }

    function setPressColor(id: LayerId, color: CAColor) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].pressColor.same(color) {
            return
        }
        self.nodes[idx.raw].pressColor = color
        self.relight(id)
    }

    // This layer is now held down, or none is.
    function setPressed(id: LayerId) {
        if id == self.pressedId {
            return
        }
        let left = self.pressedId
        self.pressedId = id
        self.relight(left)
        self.relight(id)
    }

    // The press goes from the layer held to this one, under a finger sliding
    // across a menu. Its wash does not fade out of the one and into the
    // other: it is one platter, and it travels. Drawn at this layer, it starts
    // where it stood at the last one and springs onto this one's box, taking
    // on its height on the way.
    function slidePress(id: LayerId) {
        let left = self.pressedId
        if id == left {
            return
        }
        var fromIdx = LayerSlot(0)
        var toIdx = LayerSlot(0)
        match self.nodeSlot(left) {
            None -> {
                self.setPressed(id)
                return
            }
            Some(slot) -> { fromIdx = slot }
        }
        match self.nodeSlot(id) {
            None -> {
                self.setPressed(id)
                return
            }
            Some(slot) -> { toIdx = slot }
        }
        var from = self.nodes[fromIdx.raw]
        let stood = Rect {
            x: from.platterX.presentation,
            y: from.platterY.presentation,
            width: from.boundsW.presentation + from.platterW.presentation,
            height: from.boundsH.presentation + from.platterH.presentation
        }
        let there = (((self.placement(id)).invert()).concat(self.placement(left))).applyRect(stood)
        from.platterX.setImmediate(0.0)
        from.platterY.setImmediate(0.0)
        from.platterW.setImmediate(0.0)
        from.platterH.setImmediate(0.0)
        from.fillColor = from.restingFill.channel()
        from.damaged = true
        self.nodes[fromIdx.raw] = from

        self.pressedId = id
        var follow = motionPlatterFollow(0.0)
        if self.currentTiming().reducedMotion {
            follow = motionCurveReduced(follow)
        }
        var to = self.nodes[toIdx.raw]
        to.platterX.setImmediate(there.x)
        to.platterY.setImmediate(there.y)
        to.platterW.setImmediate(there.width - to.boundsW.presentation)
        to.platterH.setImmediate(there.height - to.boundsH.presentation)
        to.platterX.startSpring(copy follow, self.clock)
        to.platterY.startSpring(copy follow, self.clock)
        to.platterW.startSpring(copy follow, self.clock)
        to.platterH.startSpring(copy follow, self.clock)
        to.fillColor = (to.shownFill(id == self.hoveredId, true)).channel()
        to.damaged = true
        self.nodes[toIdx.raw] = to
    }

    // Where a layer's own coordinates land in the canvas, at rest: its local
    // transform and every ancestor's up to the canvas, or up to the overlay it
    // is drawn in, which is placed from the canvas itself. No pull is in it.
    function placement(id: LayerId) -> CAAffineTransform {
        var placed = identity()
        var at = id
        while at != Layers.none {
            match self.nodeSlot(at) {
                None -> { return placed }
                Some(slot) -> {
                    placed = (self.nodes[slot.raw].localTransform()).concat(
                        placed
                    ) if self.nodes[slot.raw].hoisted {
                        return placed

                    }
                    at = self.nodes[slot.raw].parentId
                }
            }
        }
        return placed
    }

    // A layer's box in the canvas at rest: where it stands with nothing
    // pulling it or anything it is in.
    function restBounds(id: LayerId) -> Rect {
        match self.nodeSlot(id) {
            None -> { return Rect {} }
            Some(slot) -> {
                return (self.placement(id)).applyRect(
                    Rect {
                        x: 0.0,
                        y: 0.0,
                        width: self.nodes[slot.raw].boundsW.presentation,
                        height: self.nodes[slot.raw].boundsH.presentation
                    }
                )
            }
        }
    }

    // The pointer is now over this layer, or over none. The layer it left
    // fades back to its fill and the one it came to up to its wash, on the
    // transaction's timing like any other change.
    function setHovered(id: LayerId) {
        if id == self.hoveredId {
            return
        }
        let left = self.hoveredId
        self.hoveredId = id
        self.relight(left)
        self.relight(id)
    }

    function relight(id: LayerId) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].fillColor.applyTiming(
            self.currentTiming(),
            self.nodes[idx.raw].shownFill(id == self.hoveredId, id == self.pressedId),
            self.clock
        ) {
            self.nodes[idx.raw].damaged = true
        }
    }

    function setBorderColor(id: LayerId, color: CAColor) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].borderColor.applyTiming(timing, color, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setCornerRadius(id: LayerId, radius: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].driveCornerRadius(timing, radius, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setBorderWidth(id: LayerId, width: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].borderWidth.applyTiming(timing, width, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setTextWeight(id: LayerId, weight: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].textWeight.applyTiming(timing, weight, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    // Shadow: blur radius, opacity, and offset — each animatable.
    function setShadow(
        id: LayerId,
        radius: Number,
        opacity: Number,
        offsetX: Number,
        offsetY: Number
    ) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        let changedRadius = self.nodes[idx.raw].shadowRadius.applyTiming(timing, radius, self.clock)
        let changedOpacity = self.nodes[idx.raw].shadowOpacity.applyTiming(
            timing,
            opacity,
            self.clock
        )
        let changedX = self.nodes[idx.raw].shadowX.applyTiming(timing, offsetX, self.clock)
        let changedY = self.nodes[idx.raw].shadowY.applyTiming(timing, offsetY, self.clock)
        if changedRadius || changedOpacity || changedX || changedY {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    function setShadowColor(id: LayerId, color: CAColor) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let timing = self.currentTiming()
        if self.nodes[idx.raw].shadowColor.applyTiming(timing, color, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
        return
    }

    // --- non-animated structure --------------------------------------------

    function setContent(id: LayerId, content: CAContent) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let signature = content.signature()
        if signature != self.nodes[idx.raw].contentSignature {
            self.nodes[idx.raw].damaged = true
        }
        self.nodes[idx.raw].content = move content
        self.nodes[idx.raw].contentSignature = signature
        return
    }

    function setAnchor(id: LayerId, anchorX: Number, anchorY: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].anchorX != anchorX || self.nodes[idx.raw].anchorY != anchorY {
            self.nodes[idx.raw].anchorX = anchorX
            self.nodes[idx.raw].anchorY = anchorY
            self.nodes[idx.raw].damaged = true
        }
    }

    function setClip(id: LayerId, clip: Bool) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].clip != clip {
            self.nodes[idx.raw].clip = clip
            self.nodes[idx.raw].damaged = true
        }
    }

    function setGroupOpacity(id: LayerId, group: Bool) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].groupOpacity != group {
            self.nodes[idx.raw].groupOpacity = group
            self.nodes[idx.raw].damaged = true
        }
    }

    function setRenderTarget(id: LayerId, enabled: Bool, targetId: RenderTargetId) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].renderTarget != enabled || self.nodes[idx.raw].renderTargetId != targetId {
            self.nodes[idx.raw].renderTarget = enabled
            self.nodes[idx.raw].renderTargetId = targetId
            self.nodes[idx.raw].damaged = true
        }
    }

    function setBlur(id: LayerId, radius: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].blur.applyTiming(self.currentTiming(), radius, self.clock) {
            self.nodes[idx.raw].damaged = true
        }
    }

    function setCapturesBackdrop(id: LayerId, captures: Bool) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].capturesBackdrop != captures {
            self.nodes[idx.raw].capturesBackdrop = captures
            self.nodes[idx.raw].damaged = true
        }
    }

    function setHit(id: LayerId, hit: Bool, interactive: Bool, slidesPress: Bool, hitKey: Number) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].hit != hit || self.nodes[idx.raw].interactive != interactive || self.nodes[idx.raw].slidesPress != slidesPress || self.nodes[idx.raw].hitKey != hitKey {
            self.nodes[idx.raw].hit = hit
            self.nodes[idx.raw].interactive = interactive
            self.nodes[idx.raw].slidesPress = slidesPress
            self.nodes[idx.raw].hitKey = hitKey
        }
    }

    // Whether the layer scrolls its content, for a hit test to find.
    function setScrolls(id: LayerId, scrolls: Bool) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        if self.nodes[idx.raw].scrolls != scrolls {
            self.nodes[idx.raw].scrolls = scrolls
        }
    }

    // Set the layer's z level. Overlay(level) also hoists it out of ancestor
    // clips; Inline puts it back in tree order.
    function setLevel(id: LayerId, level: CALevel) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        var overlay = false
        match level {
            Inline -> { overlay = false }
            Overlay(z) -> { overlay = true }
        }
        self.nodes[idx.raw].level = move level
        self.nodes[idx.raw].hoisted = overlay
        if overlay && !containsLayer(self.overlays, id) {
            self.overlays.append(id)
        }
        return
    }

    // Lift a layer onto the overlay list at level 0.
    function hoist(id: LayerId) {
        self.setLevel(id, .Overlay(0))
    }

    // --- clock and frame sampling ------------------------------------------

    function setClock(now: Number) {
        self.clock = now
    }

    // Sample every channel at the current clock; returns whether anything is
    // still moving (what a runner passes as `needsRebuild`).
    function sample() -> Bool {
        var anyMoving = false
        for i in 0..self.nodes.count {
            if self.nodes[i].mounted && self.nodes[i].sample(self.clock) {
                self.nodes[i].damaged = true
                anyMoving = true
            }
        }
        if self.finishLeaving() {
            anyMoving = true
        }
        self.moving = anyMoving
        return anyMoving
    }

    // A layer whose removal has run goes on the frame it ends, not at the next
    // reconcile: it and everything it holds come out of the tree, and the
    // parent that was still drawing it stops. Whether anything went, so the
    // frame that shows it gone is drawn.
    function finishLeaving() -> Bool {
        var finished = false
        for i in 0..self.nodes.count {
            let until = self.nodes[i].leavingUntil
            if until >= 0.0 && self.clock >= until && self.nodes[i].mounted && !self.nodes[i].reused {
                self.dropFromParent(self.nodes[i].parentId, self.nodes[i].id)
                self.unmountSubtree(self.nodes[i].id)
                finished = true
            }
        }
        if finished {
            self.compactUnmounted()
        }
        return finished
    }

    function dropFromParent(parent: LayerId, id: LayerId) {
        match self.nodeSlot(parent) {
            None -> { return }
            Some(slot) -> {
                var kept: [LayerId] = []
                for child in self.nodes[slot.raw].childIds {
                    if child != id {
                        kept.append(child)
                    }
                }
                self.nodes[slot.raw].childIds = move kept
                self.nodes[slot.raw].damaged = true
            }
        }
    }

    // A child the last reconcile described again has moved on to the parent
    // that holds it now, and stays.
    function unmountSubtree(id: LayerId) {
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> {
                if !self.nodes[slot.raw].mounted || self.nodes[slot.raw].reused {
                    return
                }
                self.nodes[slot.raw].mounted = false
                self.nodes[slot.raw].leavingUntil = -1.0
                let children = copy self.nodes[slot.raw].childIds
                self.teardownCount += 1
                for child in children {
                    self.unmountSubtree(child)
                }
            }
        }
    }

    // Set the absolute clock and sample. Drift-free: the result depends only on
    // `now`, never on how the frames leading here were spaced.
    function sampleAt(now: Number) -> Bool {
        self.clock = now
        return self.sample()
    }

    // Compatibility delta form: advance the clock by dt and sample.
    function advance(dt: Number) -> Bool {
        self.clock += dt
        return self.sample()
    }

    function clearDamage() {
        for i in 0..self.nodes.count {
            if self.nodes[i].damaged {
                self.nodes[i].damaged = false
            }
        }
    }

    // --- keyed reconcile ---------------------------------------------------

    function beginReconcile() {
        for i in 0..self.nodes.count {
            self.nodes[i].reused = false
        }
    }

    // A layer described again. One that was leaving stays: it is matched
    // back, and what the description says now retargets it from wherever its
    // removal had taken it.
    function reuse(id: LayerId) {
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> {
                self.nodes[slot.raw].reused = true
                self.nodes[slot.raw].leavingUntil = -1.0
            }
        }
    }

    function setRemoval(id: LayerId, removal: CARemoval) {
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> {
                self.nodes[slot.raw].removal = removal
            }
        }
    }

    function matchChild(parent: LayerId, key: Number) -> LayerId {
        var pidx = LayerSlot(0)
        match self.nodeSlot(parent) {
            None -> { return LayerId(0) }
            Some(slot) -> { pidx = slot }
        }
        // Fields are read where they stand: a node is a large value, and
        // taking a copy of each sibling made matching a child cost the square
        // of its parent's width.
        for childId in self.nodes[pidx.raw].childIds {
            var c = 0
            match self.nodeSlot(childId) {
                None -> { continue }
                Some(slot) -> { c = slot.raw }
            }
            // A leaving layer comes back only to its own key: an unkeyed
            // sibling matched by order is some other layer.
            if self.nodes[c].mounted && !self.nodes[c].reused && self.nodes[c].key == key && (
                key != 0 || self.nodes[c].leavingUntil < 0.0
            ) {
                self.reuse(childId)
                return childId
            }
        }
        return LayerId(0)
    }

    function setChildren(parent: LayerId, childIds: [LayerId]) {
        match self.nodeSlot(parent) {
            None -> { return }
            Some(slot) -> {
                if self.nodes[slot.raw].childIds != childIds {
                    self.nodes[slot.raw].childIds = move childIds
                    self.nodes[slot.raw].damaged = true
                }
            }
        }
    }

    // Takes out every layer the description no longer has, unless it leaves
    // with a removal: then it begins leaving, where it stood under the parent
    // that still holds it, and goes once its removal has run. Whatever it
    // holds leaves with it.
    function endReconcile() -> Number {
        for i in 0..self.nodes.count {
            if self.nodes[i].mounted && !self.nodes[i].reused && self.nodes[i].leavingUntil < 0.0 && self.nodes[i].removal.duration > 0.0 && self.isReused(
                self.nodes[i].parentId
            ) {
                self.beginLeaving(self.nodes[i].id)
            }
        }
        var torn = 0
        for i in 0..self.nodes.count {
            if self.nodes[i].mounted && !self.nodes[i].reused && self.nodes[i].id != self.rootId {
                if self.stillLeaving(self.nodes[i].id) {
                    if self.nodes[i].leavingUntil >= 0.0 {
                        self.keepUnder(self.nodes[i].parentId, self.nodes[i].id)
                    }
                    continue
                }
                self.nodes[i].mounted = false
                torn += 1
            }
        }
        self.teardownCount += torn
        if torn > 0 {
            self.compactUnmounted()
        }
        return torn
    }

    // Unmounted layers never come back, so once they outweigh the live ones
    // they are dropped and every slot renumbered. Each frame walks `nodes`
    // whole, and a tree kept every layer it ever made gets slower with every
    // page it has shown.
    function compactUnmounted() {
        var unmounted = 0
        for i in 0..self.nodes.count {
            if !self.nodes[i].mounted {
                unmounted += 1
            }
        }
        if unmounted < 64 || unmounted * 3 < self.nodes.count {
            return
        }
        var kept: [CALayerNode] = []
        for i in 0..self.nodes.count {
            let id = self.nodes[i].id
            if self.nodes[i].mounted {
                self.indexOfId[id.raw] = .Some(LayerSlot(kept.count))
                kept.append(self.nodes[i])
            } else {
                self.indexOfId[id.raw] = .None
            }
        }
        self.nodes = move kept
    }

    function isReused(id: LayerId) -> Bool {
        match self.nodeSlot(id) {
            None -> return false
            Some(slot) -> return self.nodes[slot.raw].mounted && self.nodes[slot.raw].reused
        }
    }

    // The layer eases to its removal's scale and opacity and stops answering
    // presses.
    function beginLeaving(id: LayerId) {
        var idx = LayerSlot(0)
        match self.nodeSlot(id) {
            None -> { return }
            Some(slot) -> { idx = slot }
        }
        let removal = self.nodes[idx.raw].removal
        self.nodes[idx.raw].leavingUntil = self.clock + removal.duration
        self.nodes[idx.raw].hit = false
        self.nodes[idx.raw].interactive = false
        self.nodes[idx.raw].slidesPress = false
        self.nodes[idx.raw].scrolls = false
        let width = self.nodes[idx.raw].boundsW.model
        let height = self.nodes[idx.raw].boundsH.model
        let x = self.nodes[idx.raw].posX.model + removal.offset.x + removal.offsetFraction.x * width
        let y = self.nodes[idx.raw].posY.model + removal.offset.y + removal.offsetFraction.y * height
        self.beginTransaction(easeTiming(removal.duration, .EaseOut))
        self.setOpacity(id, removal.opacity)
        self.setScale(id, removal.scale, removal.scale)
        self.setPosition(id, x, y)
        self.commitTransaction()
    }

    // Whether this layer, or one it sits in, is leaving and not yet gone.
    function stillLeaving(id: LayerId) -> Bool {
        var current = id
        while current != Layers.none {
            var idx = LayerSlot(0)
            match self.nodeSlot(current) {
                None -> { return false }
                Some(slot) -> { idx = slot }
            }
            let i = idx.raw
            if self.nodes[i].reused {
                return false
            }
            if self.nodes[i].leavingUntil >= 0.0 {
                return self.clock < self.nodes[i].leavingUntil
            }
            current = self.nodes[i].parentId
        }
        return false
    }

    // A leaving layer is no longer among the children its parent was just
    // given, so it is put back, last, to be drawn until it is gone.
    function keepUnder(parent: LayerId, id: LayerId) {
        match self.nodeSlot(parent) {
            None -> { return }
            Some(slot) -> {
                for child in self.nodes[slot.raw].childIds {
                    if child == id {
                        return
                    }
                }
                self.nodes[slot.raw].childIds.append(id)
                self.nodes[slot.raw].damaged = true
            }
        }
    }

    // --- queries (presentation is what is on screen this frame) ------------

    function presentationOpacity(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> { return self.nodes[idx.raw].opacity.presentation }
        }
    }

    function presentationX(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> { return self.nodes[idx.raw].posX.presentation }
        }
    }

    function presentationBoundsW(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> { return self.nodes[idx.raw].boundsW.presentation }
        }
    }

    function presentationCornerRadius(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> {
                return self.nodes[idx.raw].cornerRadius.presentation
            }
        }
    }

    function presentationFillColor(id: LayerId) -> CAColor {
        match self.nodeSlot(id) {
            None -> { return CAColor {} } Some(idx) -> {
                return self.nodes[idx.raw].fillColor.presentation()
            }
        }
    }

    function modelOpacity(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> { return self.nodes[idx.raw].opacity.model }
        }
    }

    function opacityVelocity(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0.0 } Some(idx) -> {
                return self.nodes[idx.raw].opacity.velocity(self.clock)
            }
        }
    }

    function isAnimating(id: LayerId) -> Bool {
        match self.nodeSlot(id) {
            None -> return false
            Some(idx) -> {
                let i = idx.raw
                return self.nodes[i].posX.animating || self.nodes[i].posY.animating || self.nodes[i].boundsW.animating
                    || self.nodes[i].boundsH.animating || self.nodes[i].opacity.animating || self.nodes[i].scaleX.animating
                    || self.nodes[i].scaleY.animating || self.nodes[i].rotation.animating || self.nodes[i].cornerRadius.animating
                    || self.nodes[i].borderWidth.animating || self.nodes[i].textWeight.animating || self.nodes[i].blur.animating || self.nodes[i].fillColor.progress.animating
                    || self.nodes[i].platterX.animating || self.nodes[i].platterY.animating || self.nodes[i].platterW.animating || self.nodes[i].platterH.animating
            }
        }
    }

    function isDamaged(id: LayerId) -> Bool {
        match self.nodeSlot(id) {
            None -> { return false } Some(idx) -> { return self.nodes[idx.raw].damaged }
        }
    }

    function childCount(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0 } Some(idx) -> { return self.nodes[idx.raw].childIds.count }
        }
    }

    function isMounted(id: LayerId) -> Bool {
        match self.nodeSlot(id) {
            None -> { return false } Some(idx) -> { return self.nodes[idx.raw].mounted }
        }
    }

    // The key a layer answers presses under as the tree stands now: zero for a
    // layer that is gone or answers none.
    // The key a layer answers presses under, or 0 for none. A layer leaving,
    // or in one that is, answers none: the key it was described with is a
    // number the next build has handed to some other control, and a press it
    // still held would light that control up.
    function hitKeyOf(id: LayerId) -> Number {
        match self.nodeSlot(id) {
            None -> { return 0 }
            Some(idx) -> {
                if !self.nodes[idx.raw].mounted || self.stillLeaving(id) {
                    return 0
                }
                return self.nodes[idx.raw].hitKey
            }
        }
    }

    function pressed() -> LayerId {
        return self.pressedId
    }

}

public function layerTree() -> CALayerTree {
    return CALayerTree {}
}

public function containsLayer(values: borrow [LayerId], value: LayerId) -> Bool {
    for candidate in values {
        if candidate == value {
            return true
        }
    }
    return false
}

extend CALayerNode {
    // What a layer's fill shows: its fill, with its hover wash laid over it while
    // the pointer is on it.
    function shownFill(hovered: Bool, pressed: Bool) -> CAColor {
        let fill = self.restingFill
        var wash = CAColor { a: 0.0 }
        if hovered && pressed && self.pressColor.a > 0.0 {
            wash = self.pressColor
        } else if hovered {
            wash = self.hoverColor
        }
        if wash.a <= 0.0 {
            return fill
        }
        let a = wash.a + fill.a * (1.0 - wash.a)
        if a <= 0.0 {
            return fill
        }
        let under = fill.a * (1.0 - wash.a)
        return CAColor {
            r: (wash.r * wash.a + fill.r * under) / a,
            g: (wash.g * wash.a + fill.g * under) / a,
            b: (wash.b * wash.a + fill.b * under) / a,
            a: a
        }
    }
}
