import Foundation

// The platform's Liquid Glass recipes by name, and the GPU table that holds
// every variant of every one. Generated with the readers beside it from the
// GlassRecipes/*.klist files; the case order is the table order.

// Which glass a surface is made of: the platform's own recipe names.
public enum CAGlassRecipe {
    AbuttedSidebar
    AppIcons
    AVPlayer
    Bubbles
    Camera
    CarPlayUltra
    CartouchePopover
    Clear
    Control
    ControlCenter
    Dock
    FaceTime
    Identity
    Inspector
    Keyboard
    Loupe
    Menu
    Monogram
    NotificationCenter
    Regular
    Sidebar
    Siri
    SiriSnippet
    Slider
    Text
    Widgets
}

// The whole recipe table: for each recipe in case order, its six variants,
// each `GlassRecipeTable.recordFloats` numbers in `GlassRecipeField` order.
public function glassRecipeTable() -> [Number] {
    var table: [Number] = []
    for value in glassRecipeValuesAbuttedSidebar() { table.append(value) }
    for value in glassRecipeValuesAppIcons() { table.append(value) }
    for value in glassRecipeValuesAVPlayer() { table.append(value) }
    for value in glassRecipeValuesBubbles() { table.append(value) }
    for value in glassRecipeValuesCamera() { table.append(value) }
    for value in glassRecipeValuesCarPlayUltra() { table.append(value) }
    for value in glassRecipeValuesCartouchePopover() { table.append(value) }
    for value in glassRecipeValuesClear() { table.append(value) }
    for value in glassRecipeValuesControl() { table.append(value) }
    for value in glassRecipeValuesControlCenter() { table.append(value) }
    for value in glassRecipeValuesDock() { table.append(value) }
    for value in glassRecipeValuesFaceTime() { table.append(value) }
    for value in glassRecipeValuesIdentity() { table.append(value) }
    for value in glassRecipeValuesInspector() { table.append(value) }
    for value in glassRecipeValuesKeyboard() { table.append(value) }
    for value in glassRecipeValuesLoupe() { table.append(value) }
    for value in glassRecipeValuesMenu() { table.append(value) }
    for value in glassRecipeValuesMonogram() { table.append(value) }
    for value in glassRecipeValuesNotificationCenter() { table.append(value) }
    for value in glassRecipeValuesRegular() { table.append(value) }
    for value in glassRecipeValuesSidebar() { table.append(value) }
    for value in glassRecipeValuesSiri() { table.append(value) }
    for value in glassRecipeValuesSiriSnippet() { table.append(value) }
    for value in glassRecipeValuesSlider() { table.append(value) }
    for value in glassRecipeValuesText() { table.append(value) }
    for value in glassRecipeValuesWidgets() { table.append(value) }
    return table
}

