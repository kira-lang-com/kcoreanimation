import Foundation

// Flattening the retained tree into the presentation draw list the hit tester
// walks and the simple compositor path consumes.
//
// Each item carries the layer's EXACT oriented quad (centre, half extents,
// rotation, decomposed from the world transform — not an axis-aligned box), the
// axis-aligned clip it inherited, its resolved presentation appearance
// (perceptual fill/border colour, corner radius, border width), and the
// effective opacity folded down the tree. Items come out in paint order: a
// parent before its children, siblings in order, hoisted overlays last (by
// level), each walked from the canvas root so it escapes ancestor clips.

struct CADrawItem {
    var layer: LayerId = LayerId(0)
    var content: CAContent = .Empty
    var transform: CAAffineTransform = CAAffineTransform {}
    var quad: CAOrientedQuad = CAOrientedQuad {}
    var worldBounds: Rect = Rect {}
    var localWidth: Float = 0.0
    var localHeight: Float = 0.0
    var opacity: Float = 1.0
    var fill: CAColor = CAColor {}
    var border: CAColor = CAColor {}
    var cornerRadius: Float = 0.0
    var borderWidth: Float = 0.0
    var lengthScale: Float = 1.0
    var textScale: Float = 1.0
    var glassWash: Float = 0.0
    var glassWashLuma: Float = 1.0
    var capturesBackdrop: Bool = false
    var clipMinX: Float = 0.0
    var clipMinY: Float = 0.0
    var clipMaxX: Float = 1000000.0
    var clipMaxY: Float = 1000000.0
    var clipRadius: Float = 0.0
    var clips: Bool = false
    var groupOpacity: Bool = false
    var hit: Bool = false
    var hitKey: Int = 0
}

@Derive(Copy)
struct CAWalkFrame {
    var id: LayerId = LayerId(0)
    var world: CAAffineTransform = CAAffineTransform {}
    var opacity: Float = 1.0
    var clipMinX: Float = 0.0
    var clipMinY: Float = 0.0
    var clipMaxX: Float = 1000000.0
    var clipMaxY: Float = 1000000.0
    var clipRadius: Float = 0.0
    var glassWash: Float = 0.0
    var glassWashLuma: Float = 1.0
}

function caRootFrame(id: LayerId) -> CAWalkFrame {
    return CAWalkFrame { id: id }
}

// A layer's own transform, about its anchor, from its presentation values.
function caLocalTransform(node: borrow CALayerNode) -> CAAffineTransform {
    let w = node.boundsW.presentation
    let h = node.boundsH.presentation
    let ax = node.anchorX * w
    let ay = node.anchorY * h
    let pos = caTranslation(node.posX.presentation, node.posY.presentation)
    let rot = caRotation(node.rotation.presentation)
    let scl = caScaleTransform(node.scaleX.presentation, node.scaleY.presentation)
    let fromAnchor = caTranslation(-ax, -ay)
    let aboutAnchor = caConcat(caTranslation(ax, ay), caConcat(rot, caConcat(scl, fromAnchor)))
    return caConcat(pos, aboutAnchor)
}

function caDrawItemFor(node: borrow CALayerNode, frame: borrow CAWalkFrame, world: borrow CAAffineTransform, opacity: Float) -> CADrawItem {
    let w = node.boundsW.presentation
    let h = node.boundsH.presentation
    let lengthScale = caLengthScale(world)
    return CADrawItem {
        layer: node.id,
        content: node.content,
        transform: world,
        quad: caOrientedQuad(world, w, h),
        worldBounds: caApplyRect(world, Rect { x: 0.0, y: 0.0, width: w, height: h }),
        localWidth: w,
        localHeight: h,
        opacity: opacity,
        fill: caColorChannelPresentation(node.fillColor),
        border: caColorChannelPresentation(node.borderColor),
        cornerRadius: node.cornerRadius.presentation * lengthScale,
        borderWidth: node.borderWidth.presentation * lengthScale,
        lengthScale: lengthScale,
        textScale: caTextScale(world),
        glassWash: frame.glassWash,
        glassWashLuma: frame.glassWashLuma,
        capturesBackdrop: node.capturesBackdrop,
        clipMinX: frame.clipMinX,
        clipMinY: frame.clipMinY,
        clipMaxX: frame.clipMaxX,
        clipMaxY: frame.clipMaxY,
        clipRadius: frame.clipRadius,
        clips: node.clip,
        groupOpacity: node.groupOpacity,
        hit: node.hit,
        hitKey: node.hitKey
    }
}

// The frame a node's children inherit: the node's world and effective opacity,
// and its own world AABB intersected into the clip when it clips.
function caChildFrame(node: borrow CALayerNode, frame: borrow CAWalkFrame, world: borrow CAAffineTransform, opacity: Float) -> CAWalkFrame {
    var out = frame
    out.world = world
    out.opacity = opacity
    if node.clip {
        let box = caApplyRect(world, Rect { x: 0.0, y: 0.0, width: node.boundsW.presentation, height: node.boundsH.presentation })
        out.clipMinX = max(frame.clipMinX, box.x)
        out.clipMinY = max(frame.clipMinY, box.y)
        out.clipMaxX = min(frame.clipMaxX, box.x + box.width)
        out.clipMaxY = min(frame.clipMaxY, box.y + box.height)
        out.clipRadius = node.cornerRadius.presentation * caLengthScale(world)
    }
    match node.content {
        Glass(glass) -> {
            let wash = caGlassWash(caColorChannelPresentation(node.fillColor), glass.material)
            out.glassWash = wash.alpha
            out.glassWashLuma = wash.luma
        }
        Empty -> {}
        Solid(s) -> {}
        Text(t) -> {}
        Texture(t) -> {}
        Icon(i) -> {}
        Gradient(g) -> {}
    }
    return out
}

// One subtree, in paint order, appended to `out`. Recursion carries the
// accumulator as `borrow mut`; a hoisted child is skipped here and drawn from
// the canvas root by the overlay pass.
function caFlattenInto(tree: borrow CALayerTree, frame: borrow CAWalkFrame, out: borrow mut [CADrawItem]) {
    var idx = LayerSlot(0)
    match tree.nodeSlot(frame.id) {
        None -> { return }
        Some(slot) -> { idx = slot }
    }
    let node = tree.nodes[idx.raw]
    if !node.mounted {
        return
    }
    let world = caConcat(frame.world, caLocalTransform(node))
    let opacity = frame.opacity * node.opacity.presentation
    out.append(caDrawItemFor(node, frame, world, opacity))
    let childFrame = caChildFrame(node, frame, world, opacity)
    for childId in node.childIds {
        var cidx = LayerSlot(0)
        match tree.nodeSlot(childId) {
            None -> { continue }
            Some(slot) -> { cidx = slot }
        }
        if tree.nodes[cidx.raw].mounted && !tree.nodes[cidx.raw].hoisted {
            var cf = childFrame
            cf.id = childId
            caFlattenInto(tree, cf, out)
        }
    }
    return
}

// The overlays in draw order: by level (lower first), stable within a level.
function caOverlayLevel(tree: borrow CALayerTree, id: LayerId) -> Int {
    var idx = LayerSlot(0)
    match tree.nodeSlot(id) {
        None -> { return 0 }
        Some(slot) -> { idx = slot }
    }
    match tree.nodes[idx.raw].level {
        Inline -> return 0
        Overlay(z) -> return z
    }
}

struct CAOverlayOrder {
    let id: LayerId
    let level: Int = 0
    let ordinal: Int = 0
}

function caOverlayBefore(a: borrow CAOverlayOrder, b: borrow CAOverlayOrder) -> Bool {
    return a.level < b.level || (a.level == b.level && a.ordinal < b.ordinal)
}

function caMergeOverlayOrders(values: borrow [CAOverlayOrder], start: Int, end: Int) -> [CAOverlayOrder] {
    if end - start <= 1 {
        var one: [CAOverlayOrder] = []
        if start < end { one.append(values[start]) }
        return one
    }
    let middle = start + (end - start) / 2
    let left = caMergeOverlayOrders(values, start, middle)
    let right = caMergeOverlayOrders(values, middle, end)
    var merged: [CAOverlayOrder] = []
    var li = 0
    var ri = 0
    while li < left.count && ri < right.count {
        if caOverlayBefore(right[ri], left[li]) {
            merged.append(right[ri])
            ri += 1
        } else {
            merged.append(left[li])
            li += 1
        }
    }
    while li < left.count {
        merged.append(left[li])
        li += 1
    }
    while ri < right.count {
        merged.append(right[ri])
        ri += 1
    }
    return merged
}

function caOrderedOverlays(tree: borrow CALayerTree) -> [LayerId] {
    var entries: [CAOverlayOrder] = []
    for ordinal in 0..tree.overlays.count {
        let id = tree.overlays[ordinal]
        entries.append(CAOverlayOrder { id: id, level: caOverlayLevel(tree, id), ordinal: ordinal })
    }
    let sorted = caMergeOverlayOrders(entries, 0, entries.count)
    var ordered: [LayerId] = []
    for entry in sorted { ordered.append(entry.id) }
    return ordered
}

// The whole frame's draw list: the in-place tree, then every hoisted overlay.
function caFlatten(tree: borrow CALayerTree) -> [CADrawItem] {
    var out: [CADrawItem] = []
    if tree.rootId == LayerId(0) {
        return out
    }
    caFlattenInto(tree, caRootFrame(tree.rootId), out)
    for overlayId in caOrderedOverlays(tree) {
        caFlattenInto(tree, caRootFrame(overlayId), out)
    }
    return out
}

function caFlattenCount(tree: borrow CALayerTree) -> Int {
    return caFlatten(tree).count
}
