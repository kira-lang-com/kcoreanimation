import Foundation

// What a layer is filled with, as a CLOSED enum rather than an open family.
//
// A closed set is what the compositor exhaustively matches on when it turns a
// layer into a draw command: every arm maps to one extracted UiBatch primitive,
// and a new kind is a new arm the compiler forces every reader to answer. The
// payloads are plain value structs, so a content value clones with the node it
// rides on (the retained tree reads nodes by value).
enum CAContent {
    // A layer that only groups, clips, or transforms its children.
    Empty
    // A rounded rectangle / squircle fill with an optional border. Maps to the
    // batch's SDF surface quad (mode 0).
    Solid(CASolid)
    // A run of text. Maps to the glyph path (mode 1); the runs are resolved to
    // the atlas at submit, never here.
    Text(CAText)
    // An external KiraGraphics texture (an engine viewport, a shared surface).
    // Maps to the external-texture quad (mode 2).
    Texture(CATexture)
    // A vector icon rasterized into the glyph atlas and tinted (mode 1).
    Icon(CAIcon)
    // A refracting glass surface (mode 3). The layer's `capturesBackdrop`
    // directive decides whether the compositor opens a backdrop capture for it.
    Glass(CAGlass)
    // A linear gradient fill across the layer's bounds (mode 0 with a far
    // color and an axis).
    Gradient(CAGradient)
}

// Color as four unit channels. Its own type rather than KiraGraphics' `Color`
// so the model tree, the animation maths and the tests do not pull the graphics
// package in; the compositor converts to the backend color at the submit seam.
@Derive(Copy)
struct CAColor {
    var r: Float = 0.0
    var g: Float = 0.0
    var b: Float = 0.0
    var a: Float = 1.0
}

@Derive(Copy)
struct CAGlassWash {
    var alpha: Float = 0.0
    var luma: Float = 1.0
}

function caBlendChannel(base: Float, layer: Float, mode: Float) -> Float {
    if mode < 0.5 { return layer }
    if mode < 1.5 { return min(base + layer, 1.0) }
    if mode < 2.5 {
        if layer >= 1.0 { return base > 0.0 ? 1.0 : 0.0 }
        return min(base / (1.0 - layer), 1.0)
    }
    if mode < 3.5 {
        if layer <= 0.5 { return 2.0 * base * layer }
        return 1.0 - 2.0 * (1.0 - base) * (1.0 - layer)
    }
    if mode < 4.5 {
        if base <= 0.5 { return 2.0 * base * layer }
        return 1.0 - 2.0 * (1.0 - base) * (1.0 - layer)
    }
    if mode < 5.5 { return max(base, layer) }
    if mode < 6.5 { return min(base, layer) }
    return base * layer
}

function caGlassApplyLayer(base: Float, color: Float, alpha: Float, mode: Float) -> Float {
    if alpha <= 0.0 { return base }
    let blended = caBlendChannel(base, color, mode)
    return base + (blended - base) * alpha
}

function caGlassApplyStackChannel(base: Float, lower: Float, upper: Float, lowerAlpha: Float, material: borrow CAGlassMaterial) -> Float {
    let first = caGlassApplyLayer(base, lower, lowerAlpha, material.washBlend)
    return caGlassApplyLayer(first, upper, material.washUpperAlpha, material.washUpperBlend)
}

function caGlassWash(tint: borrow CAColor, material: borrow CAGlassMaterial) -> CAGlassWash {
    let blackR = caGlassApplyStackChannel(0.0, tint.r, material.washUpperR, tint.a, material)
    let blackG = caGlassApplyStackChannel(0.0, tint.g, material.washUpperG, tint.a, material)
    let blackB = caGlassApplyStackChannel(0.0, tint.b, material.washUpperB, tint.a, material)
    let whiteR = caGlassApplyStackChannel(1.0, tint.r, material.washUpperR, tint.a, material)
    let whiteG = caGlassApplyStackChannel(1.0, tint.g, material.washUpperG, tint.a, material)
    let whiteB = caGlassApplyStackChannel(1.0, tint.b, material.washUpperB, tint.a, material)
    let alpha = clamp(1.0 - ((whiteR - blackR) + (whiteG - blackG) + (whiteB - blackB)) / 3.0, 0.0, 1.0)
    if alpha <= 0.0001 {
        return CAGlassWash {}
    }
    let r = clamp(blackR / alpha, 0.0, 1.0)
    let g = clamp(blackG / alpha, 0.0, 1.0)
    let b = clamp(blackB / alpha, 0.0, 1.0)
    return CAGlassWash {
        alpha: alpha,
        luma: r * 0.299 + g * 0.587 + b * 0.114
    }
}

// 0 = rounded rectangle, 1 = continuous squircle. An Int on the wire between
// here and the batch, which reads the same code off its quad.
struct CASolid {
    var fill: CAColor = CAColor {}
    var border: CAColor = CAColor { a: 0.0 }
    var borderWidth: Float = 0.0
    var cornerRadius: Float = 0.0
    var shapeKind: Int = 0
}

struct CAText {
    var content: String = ""
    var color: CAColor = CAColor {}
    var size: Float = 15.0
    var weight: Float = 400.0
    // Whether a run wider than its bounds breaks onto further lines at word
    // boundaries, as a wrapped text layer does, rather than running past them.
    var wraps: Bool = false
    var adaptiveInk: Bool = false
    var inkLeft: Float = 0.0
    var inkRight: Float = 0.0
    var inkTop: Float = 0.0
    var inkBottom: Float = 0.0
}

struct CATexture {
    var handle: TextureHandle = TextureHandle(0)
    var secondaryHandle: TextureHandle = TextureHandle(0)
    var transition: Float = 0.0
    var opacity: Float = 1.0
    var cornerRadius: Float = 0.0
}

// How ink meets what is already drawn under it. A linear burn darkens what is
// beneath by how far the ink is from white, and a linear dodge lightens it by
// the ink itself — which is how Apple sets a symbol into glass: the glass shows
// through the glyph rather than being painted over by it.
@Derive(Equatable)
enum CABlendMode {
    Normal
    LinearBurn
    LinearDodge
}

function caBlendModeCode(mode: borrow CABlendMode) -> Int {
    match mode {
        Normal -> return 0
        LinearBurn -> return 1
        LinearDodge -> return 2
    }
}

// Where a blend sends a quad in the batch: its mode's code, in the hundred the
// blend names. A mode's own codes stay under 100, so a blended quad is never
// mistaken for another mode, and every code from 100 up draws through a
// blending pipeline.
function caBlendModeRoute(mode: borrow CABlendMode) -> Int {
    return caBlendModeCode(mode) * 100
}

struct CAIcon {
    var svg: String = ""
    var tint: CAColor = CAColor {}
    var weightGrowth: Float = 0.0
    var blend: CABlendMode = .Normal
}

struct CAGlass {
    var blur: Float = 1.0
    var edgeRefraction: Float = 1.0
    var tint: CAColor = CAColor { r: 1.0, g: 1.0, b: 1.0, a: 0.04 }
    var material: CAGlassMaterial = CAGlassMaterial {}
    // Touch highlight and morph target in the layer's LOCAL coordinate space.
    // The compositor applies the layer's presentation transform at submit time.
    var glowX: Float = 0.0
    var glowY: Float = 0.0
    var glowStrength: Float = 0.0
    // How far out the highlight reaches, in the same local units.
    var glowRadius: Float = 0.0
    var morphX: Float = 0.0
    var morphY: Float = 0.0
    var morphWidth: Float = 0.0
    var morphHeight: Float = 0.0
    var morphRadius: Float = 0.0
    var morphBlend: Float = 0.0
    // As a solid's, and 2 a squircle whose corner can run past the short
    // side: as wide as the radius and as tall as the side allows, up to the
    // ellipse the box holds. It clips what the surface holds to the same
    // shape.
    var shapeKind: Int = 0
    // What the surface's laid-out size does to it. Glass is one recipe across
    // every size, and only the compositor knows the size, so the recipe rides
    // on the content and is applied where the surface is drawn.
    var sizing: CAGlassSizing = CAGlassSizing {}
}

// A figure that follows a surface's size: `base + slope * extent`, held
// between `minimum` and `maximum`, where the extent is the shorter side in
// points.
@Derive(Copy)
struct CAGlassRamp {
    var base: Float = 0.0
    var slope: Float = 0.0
    var minimum: Float = 0.0
    var maximum: Float = 0.0
}

function caGlassRampAt(ramp: borrow CAGlassRamp, width: Float, height: Float) -> Float {
    return clamp(ramp.base + ramp.slope * min(width, height), ramp.minimum, ramp.maximum)
}

// What a surface's size does to its glass: how much of its blur it shows and
// how far that blurs, the grays its edge burns in, and how its top and bottom
// edges are lit. The default leaves a surface exactly as its `blur` and
// material say, which is glass that does not change with size.
@Derive(Copy)
struct CAGlassSizing {
    var blur: CAGlassRamp = CAGlassRamp { base: 1.0, minimum: 1.0, maximum: 1.0 }
    // How far the glass blurs what is behind it at this size, as a gaussian's
    // sigma in points. A ramp that tops out below zero states none, and `blur`
    // alone is the dial.
    var blurRadius: CAGlassRamp = CAGlassRamp { base: -1.0, minimum: -1.0, maximum: -1.0 }
    // The grays the edge's ring and side lines burn in at this size. A ramp
    // that tops out at zero states none, and the material's own gray stands.
    var ringTone: CAGlassRamp = CAGlassRamp {}
    var sideTone: CAGlassRamp = CAGlassRamp {}
    // The grays the top and bottom edges are lit in at this size, read the
    // same way.
    var lightDodge: CAGlassRamp = CAGlassRamp {}
    var lightBurn: CAGlassRamp = CAGlassRamp {}
}

// The blur a surface this size draws with.
function caGlassBlurAt(glass: borrow CAGlass, width: Float, height: Float) -> Float {
    let shown = glass.blur * caGlassRampAt(glass.sizing.blur, width, height)
    if glass.sizing.blurRadius.maximum < 0.0 {
        return shown
    }
    return shown * caGlassBlurDial(caGlassRampAt(glass.sizing.blurRadius, width, height), glass.material.blurNearSplit)
}

// The dial that blurs as far as `radius` points: up the sharp capture's
// crossfade to the near level, which the dial reaches at `split`, then across
// to the far level at the dial's top.
function caGlassBlurDial(radius: Float, split: Float) -> Float {
    let near = glassBlurNearRadius()
    if radius <= near {
        return split * max(radius, 0.0) / near
    }
    return min(split + (1.0 - split) * (radius - near) / (glassBlurFarRadius() - near), 1.0)
}

// The gray one of the edge's lines burns in at this size: the sizing's, when
// it states one, and the material's otherwise.
function caGlassToneAt(ramp: borrow CAGlassRamp, material: Float, width: Float, height: Float) -> Float {
    if ramp.maximum <= 0.0 {
        return material
    }
    return caGlassRampAt(ramp, width, height)
}

// The material a surface this size shades with: its own, with the edge's
// grays and its light taken at the surface's size.
function caGlassMaterialAt(glass: borrow CAGlass, width: Float, height: Float) -> CAGlassMaterial {
    let material = glass.material
    return CAGlassMaterial {
        edgeStrokeStrength: material.edgeStrokeStrength,
        edgeStrokeDarken: material.edgeStrokeDarken,
        edgeStrokePeak: material.edgeStrokePeak,
        edgeStrokeFade: material.edgeStrokeFade,
        sheenStrength: material.sheenStrength,
        lensMaxBend: material.lensMaxBend,
        refractionReach: material.refractionReach,
        blurNearSplit: material.blurNearSplit,
        borderSpread: material.borderSpread,
        borderSideOffset: material.borderSideOffset,
        borderSideSpread: material.borderSideSpread,
        borderGray: caGlassToneAt(glass.sizing.ringTone, material.borderGray, width, height),
        borderSideGray: caGlassToneAt(glass.sizing.sideTone, material.borderSideGray, width, height),
        innerRimStrength: material.innerRimStrength,
        innerRimWidth: material.innerRimWidth,
        washBlend: material.washBlend,
        washUpperR: material.washUpperR,
        washUpperG: material.washUpperG,
        washUpperB: material.washUpperB,
        washUpperAlpha: material.washUpperAlpha,
        washUpperBlend: material.washUpperBlend,
        edgeLightDodge: caGlassToneAt(glass.sizing.lightDodge, material.edgeLightDodge, width, height),
        edgeLightBurn: caGlassToneAt(glass.sizing.lightBurn, material.edgeLightBurn, width, height)
    }
}

function caGlassRampSignature(ramp: borrow CAGlassRamp) -> Int {
    return Int(round(ramp.base * 1000.0)) * 3
        + Int(round(ramp.slope * 100000.0)) * 5
        + Int(round(ramp.minimum * 1000.0)) * 7
        + Int(round(ramp.maximum * 1000.0)) * 11
}

function caGlassSizingSignature(sizing: borrow CAGlassSizing) -> Int {
    return caGlassRampSignature(sizing.blur) * 13
        + caGlassRampSignature(sizing.blurRadius) * 31
        + caGlassRampSignature(sizing.ringTone) * 17
        + caGlassRampSignature(sizing.sideTone) * 19
        + caGlassRampSignature(sizing.lightDodge) * 23
        + caGlassRampSignature(sizing.lightBurn) * 29
}

// `axis`: 0 none, 1 down, 2 across (leading→trailing), 3 corner→corner. `start`
// is the near color (also the layer's `fillColor`); `end` is the far color.
struct CAGradient {
    var start: CAColor = CAColor {}
    var end: CAColor = CAColor {}
    var axis: Int = 1
    var shapeKind: Int = 0
}

// A stable code per kind, so the flat reconcile and the damage signature stay on
// Ints (the retained passes never clone a whole content value to ask its kind).
function caContentKind(content: borrow CAContent) -> Int {
    match content {
        Empty -> return 0
        Solid(s) -> return 1
        Text(t) -> return 2
        Texture(x) -> return 3
        Icon(i) -> return 4
        Glass(g) -> return 5
        Gradient(r) -> return 6
    }
}

function caContentShapeKind(content: borrow CAContent) -> Int {
    match content {
        Solid(s) -> return s.shapeKind
        Glass(g) -> return g.shapeKind
        Gradient(g) -> return g.shapeKind
        Empty -> return 0
        Text(t) -> return 0
        Texture(t) -> return 0
        Icon(i) -> return 0
    }
}

// A corner radius as a signature term. A capsule's radius is unbounded — the
// box clamps it to half its short side when it is drawn — so it is folded to
// one code instead of being converted, which an infinite float cannot be.
function caRadiusCode(radius: Float) -> Int {
    if radius > 1000000.0 {
        return 100000000
    }
    return Int(round(radius * 100.0))
}

function caColorCode(color: borrow CAColor) -> Int {
    return Int(round(color.r * 255.0)) * 16777216
        + Int(round(color.g * 255.0)) * 65536
        + Int(round(color.b * 255.0)) * 256
        + Int(round(color.a * 255.0))
}

function caGlassMaterialSignature(material: borrow CAGlassMaterial) -> Int {
    return Int(round(material.edgeStrokeStrength * 1000.0)) * 3
        + Int(round(material.edgeStrokeDarken * 1000.0)) * 5
        + Int(round(material.edgeStrokePeak * 1000.0)) * 7
        + Int(round(material.edgeStrokeFade * 1000.0)) * 11
        + Int(round(material.sheenStrength * 1000.0)) * 13
        + Int(round(material.lensMaxBend * 100.0)) * 17
        + Int(round(material.refractionReach * 100.0)) * 19
        + Int(round(material.blurNearSplit * 1000.0)) * 23
        + Int(round(material.borderSpread * 1000.0)) * 29
        + Int(round(material.borderSideOffset * 1000.0)) * 31
        + Int(round(material.borderSideSpread * 1000.0)) * 37
        + Int(round(material.borderGray * 1000.0)) * 41
        + Int(round(material.borderSideGray * 1000.0)) * 43
        + Int(round(material.innerRimStrength * 1000.0)) * 47
        + Int(round(material.innerRimWidth * 1000.0)) * 53
        + Int(round(material.washBlend * 1000.0)) * 59
        + Int(round(material.washUpperR * 1000.0)) * 61
        + Int(round(material.washUpperG * 1000.0)) * 67
        + Int(round(material.washUpperB * 1000.0)) * 71
        + Int(round(material.washUpperAlpha * 1000.0)) * 73
        + Int(round(material.washUpperBlend * 1000.0)) * 79
        + Int(round(material.edgeLightDodge * 1000.0)) * 83
        + Int(round(material.edgeLightBurn * 1000.0)) * 89
}

// A cheap fingerprint of everything about the content that the renderer draws.
// Equal signatures across frames mean the layer's paint is unchanged, which is
// what lets a still layer be re-flushed from the retained batch (damage skip).
function caContentSignature(content: borrow CAContent) -> Int {
    match content {
        Empty -> return 1
        Solid(s) -> return 1000000
            + caColorCode(s.fill) * 31
            + caColorCode(s.border) * 17
            + Int(round(s.borderWidth * 100.0)) * 7
            + caRadiusCode(s.cornerRadius) * 3
            + s.shapeKind
        Text(t) -> return 2000000
            + t.content.count * 131
            + Int(round(t.size * 100.0)) * 31
            + Int(round(t.weight)) * 7
            + caColorCode(t.color)
            + (t.adaptiveInk ? 1 : 0) * 19
            + Int(round(t.inkLeft * 100.0)) * 23
            + Int(round(t.inkRight * 100.0)) * 29
            + Int(round(t.inkTop * 100.0)) * 37
            + Int(round(t.inkBottom * 100.0)) * 41
        Texture(x) -> return 3000000
            + x.handle.raw * 131
            + x.secondaryHandle.raw * 97
            + Int(round(x.transition * 1000.0)) * 17
            + Int(round(x.opacity * 1000.0)) * 7
            + caRadiusCode(x.cornerRadius)
        Icon(i) -> return 4000000
            + i.svg.count * 131
            + caColorCode(i.tint)
            + Int(round(i.weightGrowth * 100.0)) * 17
            + caBlendModeCode(i.blend) * 19
        Glass(g) -> return 5000000
            + Int(round(g.blur * 1000.0)) * 131
            + Int(round(g.edgeRefraction * 1000.0)) * 31
            + caColorCode(g.tint)
            + caGlassMaterialSignature(g.material)
            + caGlassSizingSignature(g.sizing)
            + Int(round(g.glowX * 100.0)) * 83
            + Int(round(g.glowY * 100.0)) * 89
            + Int(round(g.glowStrength * 1000.0)) * 97
            + Int(round(g.glowRadius * 10.0)) * 79
            + Int(round(g.morphX * 100.0)) * 101
            + Int(round(g.morphY * 100.0)) * 103
            + Int(round(g.morphWidth * 100.0)) * 107
            + Int(round(g.morphHeight * 100.0)) * 109
            + caRadiusCode(g.morphRadius) * 113
            + Int(round(g.morphBlend * 100.0)) * 127
            + g.shapeKind * 137
        Gradient(r) -> return 6000000
            + caColorCode(r.start) * 131
            + caColorCode(r.end) * 31
            + r.axis * 7
            + r.shapeKind
    }
}
