// Nominal IDs used across KCoreAnimation. These are intentionally distinct from
// Int so unrelated indices/handles cannot be passed across subsystem boundaries
// by accident. Convert to `.raw` only at array/FFI seams.
distinct RenderPassId = Int
distinct RenderTargetId = Int
distinct TextureHandle = Int
distinct DrawStreamId = Int
distinct GlassLayerId = Int
distinct RetainedNodeId = Int
distinct StateSlotId = Int
distinct ComputePipelineId = Int
distinct LayoutNodeIndex = Int
distinct LayerSlot = Int
