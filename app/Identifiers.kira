// Nominal IDs used across KCoreAnimation. These are intentionally distinct from
// Int so unrelated indices/handles cannot be passed across subsystem boundaries
// by accident. Convert to `.raw` only at array/FFI seams.
public distinct RenderPassId = Int
public distinct RenderTargetId = Int
public distinct TextureHandle = Int
public distinct DrawStreamId = Int
public distinct GlassLayerId = Int
public distinct RetainedNodeId = Int
public distinct StateSlotId = Int
public distinct ComputePipelineId = Int
public distinct LayoutNodeIndex = Int
public distinct LayerSlot = Int
