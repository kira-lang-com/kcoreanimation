// Kira-owned input method engine.
//
// This is a pure-Kira pinyin -> Hanzi composition + candidate-prediction engine.
// It deliberately depends on nothing native: it operates entirely on Unicode
// codepoints (Int), so it runs identically on the VM, LLVM/native, hybrid and
// WASM backends and can be exercised headlessly. The host (graphics layer) is
// only responsible for delivering committed/composing codepoints and for
// encoding the chosen codepoints back into UTF-8 for display.
//
// Latin input does not need the engine at all — letters commit directly. CJK
// input routes ASCII letters into a composition buffer: each completed pinyin
// syllable predicts an ordered list of Hanzi candidates, and selecting one
// commits its codepoint. Typing "ni" then space yields 你, "hao" then space
// yields 好, and so on, so "ni hao" composes 你好.

public struct ImeComposition {
    // ASCII codepoints typed so far for the in-progress syllable (the pinyin).
    var letters: [Int] = []
    // Predicted Hanzi codepoints for the current pinyin, most frequent first.
    var candidates: [Int] = []
    // Highlighted candidate (0-based) used by space / Enter commit.
    var activeIndex: Int = 0
}

public function imeReset() -> ImeComposition {
    return ImeComposition {
        letters: [],
        candidates: [],
        activeIndex: 0
    }
}

public function imeIsComposing(comp: borrow ImeComposition) -> Bool {
    return comp.letters.count > 0
}

// Build a fresh, independent copy of an Int array. Used whenever a value is
// derived from a borrowed composition: array struct fields may not alias an
// existing backing store, so we always rebuild in place.
public function imeCloneInts(src: borrow [Int]) -> [Int] {
    var out: [Int] = []
    var index = 0
    while index < src.count {
        out.append(src[index])
        index += 1
    }
    return out
}

// A pinyin letter is a-z / A-Z. Everything else (space, digits, punctuation,
// Enter) is treated as a control or commit signal by the dispatcher.
public function imeIsPinyinLetter(codepoint: Int) -> Bool {
    if codepoint >= 97 && codepoint <= 122 {
        return true
    }
    if codepoint >= 65 && codepoint <= 90 {
        return true
    }
    return false
}

public function imeLowerIndex(codepoint: Int) -> Int {
    if codepoint >= 65 && codepoint <= 90 {
        return codepoint - 65 + 1
    }
    if codepoint >= 97 && codepoint <= 122 {
        return codepoint - 97 + 1
    }
    return 0
}

// Pack the typed letters into a single base-27 integer key (a=1..z=26). Pinyin
// syllables are at most ~6 letters so the key always fits comfortably in an Int,
// and distinct syllables never collide.
public function imeKeyFromLetters(letters: borrow [Int]) -> Int {
    var key = 0
        for index in 0..letters.count {
        let slot = imeLowerIndex(letters[index])
        key = key * 27 + slot
            }
    return key
}

// Pack a literal lowercase pinyin string (provided as its ASCII codepoints) the
// same way, so the dictionary below can be written in terms of readable
// syllables instead of precomputed integers.
public function imeSyllableKey(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int) -> Int {
    var key = 0
    if a > 0 {
        key = key * 27 + a
    }
    if b > 0 {
        key = key * 27 + b
    }
    if c > 0 {
        key = key * 27 + c
    }
    if d > 0 {
        key = key * 27 + d
    }
    if e > 0 {
        key = key * 27 + e
    }
    if f > 0 {
        key = key * 27 + f
    }
    return key
}

// Built-in pinyin -> Hanzi dictionary. Each arm returns candidate codepoints in
// rough frequency order. This is a representative subset chosen so common
// phrases (你好 我是 中国 中文 谢谢 ...) can be composed end to end; it is not a
// full lexicon. The key is the base-27 packing of the lowercase syllable.
public function imeCandidatesForKey(key: Int) -> [Int] {
    // ni
    if key == imeSyllableKey(14, 9, 0, 0, 0, 0) {
        return [20320, 24744, 23612, 27877, 20393]
    }
    // hao
    if key == imeSyllableKey(8, 1, 15, 0, 0, 0) {
        return [22909, 21495, 27627, 32791]
    }
    // wo
    if key == imeSyllableKey(23, 15, 0, 0, 0, 0) {
        return [25105, 25569, 21351, 27779]
    }
    // shi
    if key == imeSyllableKey(19, 8, 9, 0, 0, 0) {
        return [26159, 26102, 21313, 20107, 24066, 30693]
    }
    // zhong
    if key == imeSyllableKey(26, 8, 15, 14, 7, 0) {
        return [20013, 37325, 38047, 31181]
    }
    // guo
    if key == imeSyllableKey(7, 21, 15, 0, 0, 0) {
        return [22269, 36807, 26524]
    }
    // wen
    if key == imeSyllableKey(23, 5, 14, 0, 0, 0) {
        return [25991, 38382, 38395, 28201]
    }
    // ma
    if key == imeSyllableKey(13, 1, 0, 0, 0, 0) {
        return [21527, 22920, 39532, 30721]
    }
    // ai
    if key == imeSyllableKey(1, 9, 0, 0, 0, 0) {
        return [29233, 21733]
    }
    // ren
    if key == imeSyllableKey(18, 5, 14, 0, 0, 0) {
        return [20154, 35748, 20219]
    }
    // da
    if key == imeSyllableKey(4, 1, 0, 0, 0, 0) {
        return [22823, 25171, 31572]
    }
    // jia
    if key == imeSyllableKey(10, 9, 1, 0, 0, 0) {
        return [23478, 21152, 20551]
    }
    // he
    if key == imeSyllableKey(8, 5, 0, 0, 0, 0) {
        return [21644, 21916, 27827]
    }
    // you
    if key == imeSyllableKey(25, 15, 21, 0, 0, 0) {
        return [26377, 21448, 21451]
    }
    // xie
    if key == imeSyllableKey(24, 9, 5, 0, 0, 0) {
        return [35874, 20889, 20123]
    }
    // hen
    if key == imeSyllableKey(8, 5, 14, 0, 0, 0) {
        return [24456, 29408, 24680]
    }
    return []
}

public function imeCandidatesForLetters(letters: borrow [Int]) -> [Int] {
    return imeCandidatesForKey(imeKeyFromLetters(letters))
}

// Append a pinyin letter and recompute predictions for the new buffer.
public function imeAppendLetter(comp: borrow ImeComposition, codepoint: Int) -> ImeComposition {
    var letters = imeCloneInts(comp.letters)
    letters.append(codepoint)
    let candidates = imeCandidatesForLetters(letters)
    return ImeComposition {
        letters: move letters,
        candidates: move candidates,
        activeIndex: 0
    }
}

// Remove the last pinyin letter. Returns a fresh (empty) composition when the
// buffer drains, signalling the dispatcher that composition has ended.
public function imeBackspace(comp: borrow ImeComposition) -> ImeComposition {
    if comp.letters.count == 0 {
        return imeReset()
    }
    var letters: [Int] = []
    var index = 0
    let keep = comp.letters.count - 1
    while index < keep {
        letters.append(comp.letters[index])
        index += 1
    }
    if letters.count == 0 {
        return imeReset()
    }
    let candidates = imeCandidatesForLetters(letters)
    return ImeComposition {
        letters: move letters,
        candidates: move candidates,
        activeIndex: 0
    }
}

public function imeClampIndex(comp: borrow ImeComposition, index: Int) -> Int {
    if comp.candidates.count == 0 {
        return 0
    }
    if index < 0 {
        return 0
    }
    if index >= comp.candidates.count {
        return comp.candidates.count - 1
    }
    return index
}

public function imeSelectIndex(comp: borrow ImeComposition, index: Int) -> ImeComposition {
    return ImeComposition {
        letters: imeCloneInts(comp.letters),
        candidates: imeCloneInts(comp.candidates),
        activeIndex: imeClampIndex(comp, index)
    }
}

public function imeSelectNext(comp: borrow ImeComposition) -> ImeComposition {
    return imeSelectIndex(comp, comp.activeIndex + 1)
}

public function imeSelectPrev(comp: borrow ImeComposition) -> ImeComposition {
    return imeSelectIndex(comp, comp.activeIndex - 1)
}

// Resolve the codepoint that would be committed for a given candidate index.
// Returns 0 when there is nothing to commit.
public function imeCandidateAt(comp: borrow ImeComposition, index: Int) -> Int {
    if comp.candidates.count == 0 {
        return 0
    }
    let clamped = imeClampIndex(comp, index)
    return comp.candidates[clamped]
}

// Commit the highlighted candidate, returning its codepoint (0 if none).
public function imeCommitActive(comp: borrow ImeComposition) -> Int {
    return imeCandidateAt(comp, comp.activeIndex)
}
