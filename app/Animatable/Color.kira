import Foundation

// Perceptual color interpolation, in OKLab.
//
// A fade animated by mixing sRGB channels darkens through a muddy middle — gray
// through the crossing of two hues, a dip in lightness between two brights —
// because sRGB is neither linear nor perceptually uniform. OKLab is built so a
// straight line between two colors reads as an even sweep, which is what a
// property animation of `backgroundColor` should look like. Every color channel
// crossfade in the layer tree goes through here.

public function caSrgbToLinear(c: Float) -> Float {
    if c <= 0.04045 {
        return c / 12.92
    }
    return pow((c + 0.055) / 1.055, 2.4)
}

public function caLinearToSrgb(c: Float) -> Float {
    let v = clamp(c, 0.0, 1.0)
    if v <= 0.0031308 {
        return v * 12.92
    }
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055
}

// One OKLab coordinate. Its own struct so the lerp reads as three numbers moving.
public struct CAOklab {
    var l: Float = 0.0
    var a: Float = 0.0
    var b: Float = 0.0
    var alpha: Float = 1.0
}

public function lerp(from: borrow CAOklab, to: borrow CAOklab, amount: Float) -> CAOklab {
    return CAOklab {
        l: lerp(from.l, to.l, amount),
        a: lerp(from.a, to.a, amount),
        b: lerp(from.b, to.b, amount),
        alpha: lerp(from.alpha, to.alpha, amount)
    }
}

public function caColorToOklab(color: borrow CAColor) -> CAOklab {
    let r = caSrgbToLinear(color.r)
    let g = caSrgbToLinear(color.g)
    let b = caSrgbToLinear(color.b)
    let l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    let m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    let s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    let lc = cbrt(l)
    let mc = cbrt(m)
    let sc = cbrt(s)
    return CAOklab {
        l: 0.2104542553 * lc + 0.7936177850 * mc - 0.0040720468 * sc,
        a: 1.9779984951 * lc - 2.4285922050 * mc + 0.4505937099 * sc,
        b: 0.0259040371 * lc + 0.7827717662 * mc - 0.8086757660 * sc,
        alpha: color.a
    }
}

public function caOklabToColor(lab: borrow CAOklab) -> CAColor {
    let lc = lab.l + 0.3963377774 * lab.a + 0.2158037573 * lab.b
    let mc = lab.l - 0.1055613458 * lab.a - 0.0638541728 * lab.b
    let sc = lab.l - 0.0894841775 * lab.a - 1.2914855480 * lab.b
    let l = lc * lc * lc
    let m = mc * mc * mc
    let s = sc * sc * sc
    let r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
    let g = 0.0 - 1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
    let b = 0.0 - 0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    return CAColor {
        r: caLinearToSrgb(r),
        g: caLinearToSrgb(g),
        b: caLinearToSrgb(b),
        a: lab.alpha
    }
}

// The color `t` of the way from `from` to `to`, mixed perceptually. Alpha rides
// linearly, which is correct: opacity is already a linear quantity.
//
// Each end's color counts by how opaque it is, as a premultiplied blend does.
// A fade to clear is a fade to transparent black, and mixed straight the color
// would darken toward that black on its way out: a light band fading in or out
// went through dark gray. Weighted, a clear end has no say in the color, and
// only the alpha moves.
public function caColorLerp(from: borrow CAColor, to: borrow CAColor, t: Float) -> CAColor {
    let a = caColorToOklab(from)
    let b = caColorToOklab(to)
    let alpha = a.alpha + (b.alpha - a.alpha) * t
    if alpha <= 0.0 {
        return caOklabToColor(lerp(a, b, t))
    }
    let wa = a.alpha * (1.0 - t)
    let wb = b.alpha * t
    return caOklabToColor(CAOklab {
        l: (a.l * wa + b.l * wb) / alpha,
        a: (a.a * wa + b.a * wb) / alpha,
        b: (a.b * wa + b.b * wb) / alpha,
        alpha: alpha
    })
}
