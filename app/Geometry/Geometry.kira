import Foundation

// The affine transform a layer draws under, and the point/rect maths the
// compositor and hit tester need. `Rect`, `Size` and `Point` are Foundation's,
// so nothing here redeclares them; the transform is the one type this layer
// adds, named `CA` so it never collides with an extracted `FoundationDeform`.
//
//   | a  c  tx |
//   | b  d  ty |
//   | 0  0  1  |
@Derive(Copy)
struct CAAffineTransform {
    var a: Float = 1.0
    var b: Float = 0.0
    var c: Float = 0.0
    var d: Float = 1.0
    var tx: Float = 0.0
    var ty: Float = 0.0
}

function caIdentity() -> CAAffineTransform {
    return CAAffineTransform {}
}

function caTranslation(x: Float, y: Float) -> CAAffineTransform {
    return CAAffineTransform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: x, ty: y }
}

function caScaleTransform(sx: Float, sy: Float) -> CAAffineTransform {
    return CAAffineTransform { a: sx, b: 0.0, c: 0.0, d: sy, tx: 0.0, ty: 0.0 }
}

function caRotation(radians: Float) -> CAAffineTransform {
    let cs = cos(radians)
    let sn = sin(radians)
    return CAAffineTransform { a: cs, b: sn, c: -sn, d: cs, tx: 0.0, ty: 0.0 }
}

function caIsIdentity(t: borrow CAAffineTransform) -> Bool {
    return t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && t.tx == 0.0 && t.ty == 0.0
}

function caScaleX(t: borrow CAAffineTransform) -> Float {
    return sqrt(t.a * t.a + t.b * t.b)
}

function caScaleY(t: borrow CAAffineTransform) -> Float {
    return sqrt(t.c * t.c + t.d * t.d)
}

function caLengthScale(t: borrow CAAffineTransform) -> Float {
    return min(caScaleX(t), caScaleY(t))
}

// The scale text under `t` is shown at, exactly: text is set at its own size
// and its glyphs scaled by this, so it follows a scale as smoothly as the
// layers around it do.
function caTextScale(t: borrow CAAffineTransform) -> Float {
    return sqrt(max(caScaleX(t) * caScaleY(t), 0.0001))
}

// `outer` applied to the result of `inner`: outer * inner, so a child's own
// transform composes under its parent's.
function caConcat(outer: borrow CAAffineTransform, inner: borrow CAAffineTransform) -> CAAffineTransform {
    return CAAffineTransform {
        a: outer.a * inner.a + outer.c * inner.b,
        b: outer.b * inner.a + outer.d * inner.b,
        c: outer.a * inner.c + outer.c * inner.d,
        d: outer.b * inner.c + outer.d * inner.d,
        tx: outer.a * inner.tx + outer.c * inner.ty + outer.tx,
        ty: outer.b * inner.tx + outer.d * inner.ty + outer.ty
    }
}

function caApplyX(t: borrow CAAffineTransform, x: Float, y: Float) -> Float {
    return t.a * x + t.c * y + t.tx
}

function caApplyY(t: borrow CAAffineTransform, x: Float, y: Float) -> Float {
    return t.b * x + t.d * y + t.ty
}

function caApplyPoint(t: borrow CAAffineTransform, x: Float, y: Float) -> Point {
    return Point { x: caApplyX(t, x, y), y: caApplyY(t, x, y) }
}

// The axis-aligned bounding box of a rectangle carried through the transform.
// Rotation turns a rect into a quad, so the four corners are mapped and the
// extremes taken — the box a clip or a damage rect is measured in.
function caApplyRect(t: borrow CAAffineTransform, rect: borrow Rect) -> Rect {
    let x0 = rect.x
    let y0 = rect.y
    let x1 = rect.x + rect.width
    let y1 = rect.y + rect.height
    let ax = caApplyX(t, x0, y0)
    let ay = caApplyY(t, x0, y0)
    let bx = caApplyX(t, x1, y0)
    let by = caApplyY(t, x1, y0)
    let cx = caApplyX(t, x1, y1)
    let cy = caApplyY(t, x1, y1)
    let dx = caApplyX(t, x0, y1)
    let dy = caApplyY(t, x0, y1)
    let minX = min(min(ax, bx), min(cx, dx))
    let maxX = max(max(ax, bx), max(cx, dx))
    let minY = min(min(ay, by), min(cy, dy))
    let maxY = max(max(ay, by), max(cy, dy))
    return Rect { x: minX, y: minY, width: maxX - minX, height: maxY - minY }
}

// The inverse, for hit testing: a screen point is carried back into a layer's
// own coordinates and tested against its untransformed bounds, so a rotated or
// scaled layer is pressable where it is drawn rather than where it was laid out.
function caDeterminant(t: borrow CAAffineTransform) -> Float {
    return t.a * t.d - t.b * t.c
}

function caInvert(t: borrow CAAffineTransform) -> CAAffineTransform {
    let det = caDeterminant(t)
    if det == 0.0 {
        // A degenerate transform (a zero scale) maps everything to a line and
        // has no inverse; the identity is returned so a hit test degrades to
        // "misses everything under it" rather than dividing by zero.
        return caIdentity()
    }
    let inv = 1.0 / det
    let ia = t.d * inv
    let ib = (-t.b) * inv
    let ic = (-t.c) * inv
    let id = t.a * inv
    return CAAffineTransform {
        a: ia,
        b: ib,
        c: ic,
        d: id,
        tx: -(ia * t.tx + ic * t.ty),
        ty: -(ib * t.tx + id * t.ty)
    }
}

// A layer's world quad as the batch draws it: a center, half extents along the
// layer's own axes, and a rotation. Decomposed from the world transform, so a
// rotated/scaled layer becomes an EXACT oriented quad (the batch rotates it
// about its center in the vertex stage) rather than an axis-aligned bounding box.
// Assumes a shear-free transform (translate/rotate/scale), which UI composition
// produces.
@Derive(Copy)
struct CAOrientedQuad {
    var centerX: Float = 0.0
    var centerY: Float = 0.0
    var halfW: Float = 0.0
    var halfH: Float = 0.0
    var rotCos: Float = 1.0
    var rotSin: Float = 0.0
}

function caOrientedQuad(world: borrow CAAffineTransform, width: Float, height: Float) -> CAOrientedQuad {
    let center = caApplyPoint(world, width / 2.0, height / 2.0)
    let sx = sqrt(world.a * world.a + world.b * world.b)
    let sy = sqrt(world.c * world.c + world.d * world.d)
    var rotCos = 1.0
    var rotSin = 0.0
    if sx > 0.0 {
        rotCos = world.a / sx
        rotSin = world.b / sx
    }
    return CAOrientedQuad {
        centerX: center.x,
        centerY: center.y,
        halfW: width / 2.0 * sx,
        halfH: height / 2.0 * sy,
        rotCos: rotCos,
        rotSin: rotSin
    }
}

function caRectContains(rect: borrow Rect, x: Float, y: Float) -> Bool {
    return x >= rect.x && x <= rect.x + rect.width && y >= rect.y && y <= rect.y + rect.height
}

function caLocalContains(width: Float, height: Float, x: Float, y: Float) -> Bool {
    return x >= 0.0 && x <= width && y >= 0.0 && y <= height
}
