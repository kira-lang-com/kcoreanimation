import KiraGraphics
public function foundationAppendCodepoint(base: borrow String, codepoint: Int) -> String {
    return graphicsAppendCodepoint(base, codepoint)
}

public function foundationDropLastScalar(base: borrow String) -> String {
    return graphicsDropLastScalar(base)
}

public function foundationConcat(base: borrow String, suffix: borrow String) -> String {
    return graphicsStringConcat(base, suffix)
}